<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="-8407556" id="-8407556">Oʻzbekiston Respublikasining Konstitutsiyaviy Qonuni</div></div><div class="ACT_TITLE"><div name="-8407557" id="-8407557"><b>Oʻzbekiston Respublikasi Prezidenti Administratsiyasi toʻgʻrisida</b></div></div><div class="GRIF_PARLAMENT"><div name="-8407558" id="-8407558">Qonunchilik palatasi tomonidan 2026-yil 6-avgustda qabul qilingan<br />Senat tomonidan 2026-yil 7-avgustda maʼqullangan</div></div><div class="BY_DEFAULT"><div name="-8407559" id="-8407559"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8407560" id="-8407560"><b>1-bob. Umumiy qoidalar</b></div></div><div class="CLAUSE_DEFAULT"><div name="-8407561" id="-8407561"><b>1-modda. Ushbu Konstitutsiyaviy Qonunning maqsadi</b></div></div><div class="ACT_TEXT"><div name="-8407562" id="-8407562">Ushbu Konstitutsiyaviy Qonunning maqsadi Oʻzbekiston Respublikasi Prezidenti Administratsiyasining (bundan buyon matnda Administratsiya deb yuritiladi) faoliyatini tartibga solishdan iborat.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407563" id="-8407563"><b>2-modda. Administratsiya toʻgʻrisidagi qonunchilik</b></div></div><div class="ACT_TEXT"><div name="-8407564" id="-8407564">Administratsiya toʻgʻrisidagi qonunchilik Oʻzbekiston Respublikasining <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasi</a>, ushbu Konstitutsiyaviy Qonun, Oʻzbekiston Respublikasi Prezidentining farmonlari va qarorlari, shuningdek boshqa qonunchilik hujjatlaridan iboratdir.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407565" id="-8407565"><b>3-modda. Administratsiyaning huquqiy maqomi</b></div></div><div class="ACT_TEXT"><div name="-8407566" id="-8407566">Administratsiya Oʻzbekiston Respublikasi Prezidentining davlat boshligʻi sifatida davlat hokimiyati organlarining kelishilgan holda faoliyat yuritishini va hamkorligini taʼminlashiga koʻmaklashadigan, Oʻzbekiston Respublikasi Prezidentining vakolatlarini amalga oshirishni tashkiliy, huquqiy va tahliliy jihatdan taʼminlaydigan davlat organidir.</div></div><div class="ACT_TEXT"><div name="-8407567" id="-8407567">Administratsiya Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlari ijrosi doirasida davlat organlarining va tashkilotlarining, davlat ishtirokidagi korxonalarning (bundan buyon matnda davlat organlari va tashkilotlari deb yuritiladi) faoliyatini muvofiqlashtiradi, mazkur hujjatlarning ijrosini monitoring qiladi va nazoratini tashkil etadi.</div></div><div class="ACT_TEXT"><div name="-8407568" id="-8407568">Administratsiya oʻz faoliyatida bevosita Oʻzbekiston Respublikasi Prezidentiga boʻysunadi va unga hisobdordir.</div></div><div class="ACT_TEXT"><div name="-8407569" id="-8407569">Administratsiya yuridik shaxs hisoblanadi, u Oʻzbekiston Respublikasi Davlat gerbi tasviri tushirilgan hamda oʻz nomi davlat tilida yozilgan muhrga va blankalarga ega boʻladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407570" id="-8407570"><b>4-modda. Administratsiya faoliyatining asosiy prinsiplari</b></div></div><div class="ACT_TEXT"><div name="-8407571" id="-8407571">Administratsiya faoliyatining asosiy prinsiplari Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasi </a>va qonunlarining ustunligi, inson huquqlari va erkinliklarining ustuvorligi, xolislik, mustaqillik, ochiqlik hamda shaffoflikdan iborat.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407572" id="-8407572"><b>5-modda. Administratsiyani shakllantirish</b></div></div><div class="ACT_TEXT"><div name="-8407573" id="-8407573">Administratsiya Oʻzbekiston Respublikasi Prezidenti tomonidan shakllantiriladi.</div></div><div class="ACT_TEXT"><div name="-8407574" id="-8407574">Administratsiyaga Oʻzbekiston Respublikasi Prezidenti tomonidan lavozimga tayinlanadigan va lavozimidan ozod etiladigan Administratsiya Rahbari boshchilik qiladi.</div></div><div class="ACT_TEXT"><div name="-8407575" id="-8407575">Administratsiya oʻz faoliyatini Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadigan asosiy yoʻnalishlar doirasida amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8407576" id="-8407576">Administratsiya Rahbari va uning shartnoma asosida jalb qilinadigan maslahatchilari, Oʻzbekiston Respublikasi Prezidentining yordamchisi, Administratsiya Rahbarining oʻrinbosarlari, Administratsiya Rahbari kotibiyati mudiri, Oʻzbekiston Respublikasi Prezidentining maslahatchilari, ularning birinchi oʻrinbosarlari va oʻrinbosarlari, Oʻzbekiston Respublikasi Prezidentining vakillari, Administratsiya tarkibiy boʻlinmalarining boshliqlari hamda ularning birinchi oʻrinbosarlari va oʻrinbosarlari Administratsiyaning mansabdor shaxslari (bundan buyon matnda Administratsiyaning mansabdor shaxslari deb yuritiladi) hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8407577" id="-8407577">Administratsiya boshqaruv va xizmatchi xodimlarining lavozimlari roʻyxati Administratsiya toʻgʻrisidagi nizomda belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8407578" id="-8407578">Administratsiyaning reglamenti, Oʻzbekiston Respublikasi Prezidenti huzuridagi davlat organlari va tashkilotlari toʻgʻrisidagi nizomlar Oʻzbekiston Respublikasi Prezidenti tomonidan, Administratsiya toʻgʻrisidagi nizom, Administratsiya huzuridagi davlat organlari va tashkilotlari toʻgʻrisidagi nizomlar, Administratsiya tarkibiy boʻlinmalari faoliyatining asosiy yoʻnalishlari va Administratsiya xodimlarining shtatlar jadvali Administratsiya Rahbari tomonidan tasdiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8407579" id="-8407579">Administratsiyaning tarkibiy boʻlinmalari toʻgʻrisidagi nizomlar, Administratsiya xodimlarining funksional vazifalari va Administratsiya tarkibiy boʻlinmalarining tuzilmalari Administratsiya tarkibiy boʻlinmalarining boshliqlari tomonidan tasdiqlanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407580" id="-8407580"><b>6-modda. Administratsiyaning asosiy vazifalari</b></div></div><div class="ACT_TEXT"><div name="-8407581" id="-8407581">Administratsiyaning asosiy vazifalari quyidagilardan iborat:</div></div><div class="ACT_TEXT"><div name="-8407582" id="-8407582">Oʻzbekiston Respublikasi Prezidentining faoliyatini tashkiliy, huquqiy va tahliliy jihatdan taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407583" id="-8407583">mamlakatning ijtimoiy-iqtisodiy va ijtimoiy-siyosiy rivojlanishi holatini tahlil qilish, Oʻzbekiston Respublikasi Prezidenti tomonidan amalga oshirilayotgan islohotlarni tashkiliy, huquqiy va tahliliy jihatdan taʼminlash hamda yangi muhim tashabbuslarni ishlab chiqish;</div></div><div class="ACT_TEXT"><div name="-8407584" id="-8407584">mamlakatda qonuniylikni va huquq-tartibotni, fuqarolarning huquq va erkinliklariga, Oʻzbekiston Respublikasining <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasi </a>va qonunlariga rioya etilishini taʼminlashga hamda sud-huquq tizimini isloh qilishga koʻmaklashish;</div></div><div class="ACT_TEXT"><div name="-8407585" id="-8407585">huquqni muhofaza qiluvchi va nazorat qiluvchi organlar, kuch ishlatishga vakolatli tuzilmalar hamda Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari, mansabdor shaxslar faoliyatini muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-8407586" id="-8407586">davlat ichki va tashqi siyosatining asosiy yoʻnalishlari, Oʻzbekiston Respublikasining suverenitetini himoya qilish, uning xavfsizligini va hududiy yaxlitligini taʼminlash boʻyicha takliflar ishlab chiqish;</div></div><div class="ACT_TEXT"><div name="-8407587" id="-8407587">aholi va tadbirkorlik subyektlari bilan ochiq va toʻgʻridan-toʻgʻri muloqotni tashkil etish hamda xalq farovonligini yuksaltirish, jismoniy va yuridik shaxslarning Oʻzbekiston Respublikasi Prezidentiga murojaat qilish huquqlari amalga oshirilishi uchun shart-sharoitlar yaratish;</div></div><div class="ACT_TEXT"><div name="-8407588" id="-8407588">davlat hokimiyati vakillik organlari va fuqarolik jamiyati institutlari bilan demokratik huquqiy davlat va ochiq fuqarolik jamiyatini barpo etishda ularning rolini kuchaytirishga qaratilgan samarali hamkorlikni tashkil etish, umummilliy hamjihatlikni mustahkamlash;</div></div><div class="ACT_TEXT"><div name="-8407589" id="-8407589">yagona davlat kadrlar siyosati amalga oshirilishini va davlat xizmati ishlarining boshqarilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407590" id="-8407590">Oʻzbekiston Respublikasi Prezidenti va Administratsiya huzuridagi davlat organlari va tashkilotlarining, shuningdek Oʻzbekiston Respublikasi Prezidentining vakolatlarini amalga oshirishga koʻmaklashuvchi maslahat-kengash organlarining faoliyatini tashkil etish hamda Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashining faoliyati Oʻzbekiston Respublikasi Prezidenti tomonidan muvofiqlashtirilishini tashkiliy, huquqiy va tahliliy jihatdan taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407591" id="-8407591">Oʻzbekiston Respublikasi Prezidentining qonunchilik siyosati sohasidagi vakolatlari amalga oshirilishini tashkil etish va taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407592" id="-8407592">Oʻzbekiston Respublikasi Prezidentining inson huquqlariga va Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasiga </a>rioya etilishining kafili sifatidagi, davlat suverenitetini, xavfsizligini va hududiy yaxlitligini taʼminlash vakolatlari amalga oshirilishini tashkil etish;</div></div><div class="ACT_TEXT"><div name="-8407593" id="-8407593">Oʻzbekiston Respublikasi Prezidentining davlat hokimiyati organlarining kelishilgan holda faoliyat yuritishini va hamkorligini taʼminlash boʻyicha vakolatlari amalga oshirilishini tashkil etish;</div></div><div class="ACT_TEXT"><div name="-8407594" id="-8407594">Oʻzbekiston Respublikasi Prezidentining xalqaro munosabatlar bilan bogʻliq faoliyatiga oid vakolatlari amalga oshirilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407595" id="-8407595">Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi xalqiga hamda Oliy Majlisiga mamlakat ichki va tashqi siyosatini amalga oshirishning eng muhim masalalari yuzasidan murojaat qilish huquqi amalga oshirilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407596" id="-8407596">Oʻzbekiston Respublikasi Prezidentining fuqarolik va siyosiy boshpana berish, amnistiya va sudlar tomonidan hukm qilingan shaxslarni afv etishga oid masalalarni koʻrib chiqish boʻyicha vakolatlari amalga oshirilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-8407597" id="-8407597">qonunlar va Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlarining, Administratsiya Rahbari farmoyishlari va topshiriqlarining ijro etilishini tashkil etish, nazoratini olib borish hamda ularni amalga oshirishga koʻmaklashish.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8407598" id="-8407598"><b>2-bob. Administratsiyaning faoliyatini tashkil etish</b></div></div><div class="CLAUSE_DEFAULT"><div name="-8407599" id="-8407599"><b>7-modda. Administratsiyaning asosiy vakolatlari</b></div></div><div class="ACT_TEXT"><div name="-8407600" id="-8407600">Administratsiya oʻz zimmasiga yuklatilgan vazifalarni bajarish uchun quyidagi asosiy vakolatlarga ega boʻladi:</div></div><div class="ACT_TEXT"><div name="-8407601" id="-8407601">Administratsiyaga belgilangan tartibda kiritilgan qonunchilik hujjatlarini, Oʻzbekiston Respublikasi Prezidentining va Oʻzbekiston Respublikasi Vazirlar Mahkamasining farmoyishlari loyihalarini yakuniy ishlab chiqishni tashkil etish;</div></div><div class="ACT_TEXT"><div name="-8407602" id="-8407602">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari, Administratsiya Rahbarining farmoyishlari hamda Oʻzbekiston Respublikasi Vazirlar Mahkamasining qarorlari va farmoyishlari loyihalarini mustaqil ravishda ishlab chiqish;</div></div><div class="ACT_TEXT"><div name="-8407603" id="-8407603">mamlakatni ijtimoiy-iqtisodiy va ijtimoiy-siyosiy rivojlantirishning dolzarb yoʻnalishlarini oʻrganish hamda takliflar ishlab chiqish uchun davlat organlari va tashkilotlarining rahbarlari, shu jumladan hokimlar boshchiligida ishchi komissiyalar va ishchi guruhlar tuzish;</div></div><div class="ACT_TEXT"><div name="-8407604" id="-8407604">zarur materiallar va maʼlumotlarni davlat organlari va tashkilotlaridan soʻrash hamda olish, shu jumladan qonunchilik hujjatlarida belgilangan tartibda doimiy asosda olish, barcha davlat organlari va tashkilotlarining axborot tizimlaridan, maʼlumotlar bazalaridan, axborot-maʼlumot qaydlaridan, arxivlaridan, maʼlumotlarga ishlov berishning avtomatlashtirilgan tizimlaridan hamda boshqa axborot resurslaridan foydalanish;</div></div><div class="ACT_TEXT"><div name="-8407605" id="-8407605">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari, Oʻzbekiston Respublikasi Prezidenti va Administratsiya huzuridagi davlat organlari va tashkilotlari faoliyatini muvofiqlashtirish hamda nazorat qilish;</div></div><div class="ACT_TEXT"><div name="-8407606" id="-8407606">davlat organlari va tashkilotlari rahbarlariga bajarilishi majburiy boʻlgan koʻrsatmalar hamda topshiriqlar berish, ularning bajarilishi va natijalari toʻgʻrisida batafsil maʼlumot talab qilish;</div></div><div class="ACT_TEXT"><div name="-8407607" id="-8407607">qonunlarni va Oʻzbekiston Respublikasi Prezidentining farmonlarini, qarorlari, farmoyishlari va topshiriqlarini, Administratsiya Rahbarining farmoyishlari va topshiriqlarini amalga oshirish yuzasidan davlat organlari va tashkilotlarining faoliyatini qonunchilik hujjatlariga muvofiq oʻrganish, shuningdek oʻrganish natijalari boʻyicha materiallarni aniqlangan qoidabuzarliklarni va kamchiliklarni bartaraf etish uchun ushbu davlat organlari va tashkilotlarining rahbarlariga yuborish;</div></div><div class="ACT_TEXT"><div name="-8407608" id="-8407608">davlat organlari va tashkilotlarining mansabdor shaxslari faoliyati samaradorligini, ular tomonidan qonunlarning va Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari, farmoyishlari va topshiriqlarining, Administratsiya Rahbari farmoyishlari va topshiriqlarining ijrosini taʼminlash holatini baholash, shuningdek bu borada oʻz zimmasiga yuklatilgan vazifalarni bajarmaganligi yoki lozim darajada bajarmaganligi uchun ushbu mansabdor shaxslarni intizomiy javobgarlikka tortish, shu jumladan egallab turgan lavozimidan ozod etishgacha boʻlgan masala yuzasidan tashabbus koʻrsatish;</div></div><div class="ACT_TEXT"><div name="-8407609" id="-8407609">davlat organlari va tashkilotlari zimmasiga yuklatilgan vazifalarning ijrosi va ularga biriktirilgan tarmoq (soha) boʻyicha aniq natijalarga erishishning borishini koʻrib chiqish hamda muhokama qilish maqsadida navbatdan tashqari hayʼatlarni (yigʻilishlarni) chaqirish yuzasidan takliflar kiritish;</div></div><div class="ACT_TEXT"><div name="-8407610" id="-8407610">axborot-tahliliy materiallarni, shuningdek normativ-huquqiy hujjatlar loyihalarini tayyorlash doirasida davlat organlari va tashkilotlarining, shuningdek boshqa tashkilotlarning mansabdor shaxslarini va mutaxassislarini jalb etish;</div></div><div class="ACT_TEXT"><div name="-8407611" id="-8407611">davlat organlari va tashkilotlarining komplayens va korrupsiyaga qarshi ichki nazorat tuzilmalari faoliyatini tashkil etish hamda qonunchilik hujjatlari bilan ushbu tuzilmalar zimmasiga yuklatilgan vazifalarning ular tomonidan amalga oshirilishini muvofiqlashtirish;</div></div><div class="ACT_TEXT"><div name="-8407612" id="-8407612">Administratsiyaga ishga qabul qilish uchun nomzodlarni davlat organlaridan va tashkilotlaridan mustaqil ravishda tanlab olishni amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-8407613" id="-8407613">jismoniy va yuridik shaxslarning Administratsiyaga kelib tushadigan murojaatlari koʻrib chiqilishini, shu jumladan Oʻzbekiston Respublikasi Prezidentining Xalq qabulxonasi tomonidan koʻrib chiqilishini tashkil etish;</div></div><div class="ACT_TEXT"><div name="-8407614" id="-8407614">Oʻzbekiston Respublikasining davlat mukofotlari bilan mukofotlash, koʻkrak nishonlari bilan taqdirlash uchun nomzodlarning oʻrganilishini tashkil etish;</div></div><div class="ACT_TEXT"><div name="-8407615" id="-8407615">oʻz zimmasiga yuklatilgan vazifalarning bajarilishini taʼminlash sohasidagi davlat sirlarini tashkil etuvchi arxiv maʼlumotlarini hamda boshqa maʼlumotlarni saqlash, rasmiylashtirish, ulardan foydalanish va ularni berishning alohida tartibini belgilash, zarur axborot tizimlarini yaratish, shuningdek maxfiylik rejimini mustaqil ravishda taʼminlash, unga rioya etilishini nazorat qilish hamda tegishli normativ-huquqiy hujjatlarning talablari bajarilishini tekshirish tadbirlarini tashkil etish.</div></div><div class="ACT_TEXT"><div name="-8407616" id="-8407616">Administratsiya qonunchilik hujjatlariga muvofiq boshqa vakolatlarga ham ega boʻlishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407617" id="-8407617"><b>8-modda. Administratsiya Rahbarining huquqiy maqomi</b></div></div><div class="ACT_TEXT"><div name="-8407618" id="-8407618">Administratsiyaning faoliyati mazkur Konstitutsiyaviy Qonun va Oʻzbekiston Respublikasi Prezidenti tomonidan Administratsiya zimmasiga yuklatilgan vazifalarga va asosiy yoʻnalishlarga muvofiq Administratsiya Rahbari tomonidan tashkil etiladi hamda muvofiqlashtiriladi.</div></div><div class="ACT_TEXT"><div name="-8407619" id="-8407619">Administratsiya Rahbari Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasida </a>va boshqa qonunchilik hujjatlarida belgilangan vakolatlarini, shu jumladan davlat hokimiyati organlarining kelishilgan holda faoliyat yuritishini va hamkorligini taʼminlashga oid vakolatlarini amalga oshirishni tashkiliy, huquqiy va tahliliy jihatdan taʼminlashni tashkil etish uchun masʼul mansabdor shaxs hisoblanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407620" id="-8407620"><b>9-modda. Administratsiya Rahbarining vakolatlari</b></div></div><div class="ACT_TEXT"><div name="-8407621" id="-8407621">Administratsiya Rahbari:</div></div><div class="ACT_TEXT"><div name="-8407622" id="-8407622">Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasiga </a>muvofiq Oʻzbekiston Respublikasi Prezidentining davlat boshligʻi sifatida davlat hokimiyati organlarining kelishilgan holda faoliyat yuritishini hamda hamkorligini taʼminlashga oid faoliyatini tashkiliy, huquqiy va tahliliy jihatdan taʼminlashga rahbarlik qiladi;</div></div><div class="ACT_TEXT"><div name="-8407623" id="-8407623">Oʻzbekiston Respublikasi Prezidenti muvofiqlashtiruvida Administratsiya faoliyatiga rahbarlik qiladi, Administratsiya tarkibiy boʻlinmalarining tizimli faoliyatini taʼminlaydi, Administratsiyaning faoliyatini tashkil etishga doir farmoyishlar chiqaradi;</div></div><div class="ACT_TEXT"><div name="-8407624" id="-8407624">Administratsiyaning tashkiliy tuzilmasiga qoʻshimcha shtat birliklarini kiritadi va qisqartiradi, tegishli sohalar va tarmoqlarni rivojlantirish boʻyicha loyiha ofislarini tashkil etadi hamda tugatadi;</div></div><div class="ACT_TEXT"><div name="-8407625" id="-8407625">Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi Oliy Majlisi palatalari (bundan buyon matnda Oliy Majlis palatalari deb yuritiladi), sud hokimiyati hamda sudyalar hamjamiyati organlari bilan hamkorligini tashkiliy, huquqiy va tahliliy jihatdan taʼminlash choralarini koʻradi, Oʻzbekiston Respublikasi Vazirlar Mahkamasi, huquqni muhofaza qiluvchi va nazorat qiluvchi organlar hamda kuch ishlatishga vakolatli tuzilmalar faoliyatiga oid vakolatlari amalga oshirilishini taʼminlash choralarini koʻradi;</div></div><div class="ACT_TEXT"><div name="-8407626" id="-8407626">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari rahbarlari faoliyatini nazorat qiladi, muvofiqlashtiradi hamda uning natijadorligini baholashni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407627" id="-8407627">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari rahbarlariga oʻz vakolatlari doirasida topshiriqlar beradi hamda ularning ijrosini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407628" id="-8407628">Oʻzbekiston Respublikasi Prezidenti uchun axborot-tahliliy va tashkiliy materiallarni tayyorlashni tashkil etadi, jamiyat va davlat hayoti uchun muhim boʻlgan masalalar yuzasidan Oʻzbekiston Respublikasi Prezidentiga tahliliy axborot kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407629" id="-8407629">Oʻzbekiston Respublikasi Prezidenti huzuridagi maslahat-kengash organlari faoliyatini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407630" id="-8407630">Oʻzbekiston Respublikasi Prezidentining qonunchilik tashabbusi huquqlari amalga oshirilishini taʼminlash choralarini koʻradi, Oʻzbekiston Respublikasi Prezidenti tomonidan qabul qilinadigan normativ-huquqiy tusdagi va boshqa hujjatlar loyihalarini tayyorlashni muvofiqlashtiradi, shuningdek Oʻzbekiston Respublikasi Prezidentining qonunchilik tashabbusi huquqi asosida kiritilgan qonun loyihalarini Oliy Majlis palatalarida koʻrib chiqish jarayonlarida oʻz vakillari orqali ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8407631" id="-8407631">respublika va mahalliy ijro etuvchi hokimiyat organlarida maʼmuriy islohotlarning amalga oshirilishini muvofiqlashtiradi va nazorat qiladi, shuningdek davlat boshqaruvi tizimini takomillashtirish boʻyicha Oʻzbekiston Respublikasi Prezidentiga takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407632" id="-8407632">davlat organlari va tashkilotlarining qonunchilik hujjatlarida belgilangan tartibda Oʻzbekiston Respublikasi Prezidenti bilan kelishishi talab etiladigan masalalarni koʻrib chiqishni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407633" id="-8407633">hududiy rivojlanish dasturlarini amalga oshirishni muvofiqlashtiradi va hududlarning ijtimoiy-iqtisodiy rivojlanishi holatini monitoring qiladi, shuningdek hududlarni rivojlantirishdagi tizimli muammolarni hal etish boʻyicha Oʻzbekiston Respublikasi Prezidentiga takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407634" id="-8407634">Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari, farmoyishlari va topshiriqlarining ijrosi ustidan nazoratni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407635" id="-8407635">respublika va mahalliy ijro etuvchi hokimiyat organlari rahbarlarining Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlari ijrosi toʻgʻrisidagi hisobotlarini qabul qiladi, ularni lozim darajada bajarmagan mansabdor shaxslarga nisbatan lavozimdan ozod etishgacha boʻlgan intizomiy taʼsir choralarini qoʻllashni tashkil etadi, ushbu masalalar boʻyicha Oʻzbekiston Respublikasi Prezidentiga takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407636" id="-8407636">davlat organlari uchun asosiy samaradorlik koʻrsatkichlari tizimining joriy etilishiga va amal qilishiga koʻmaklashadi;</div></div><div class="ACT_TEXT"><div name="-8407637" id="-8407637">belgilangan tartibda davlat organlari va tashkilotlari tomonidan kiritilgan Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari va farmoyishlari loyihalarining huquqiy, moliyaviy, korrupsiyaga qarshi hamda boshqa turdagi ekspertizalarini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407638" id="-8407638">jismoniy va yuridik shaxslarning Oʻzbekiston Respublikasi Prezidenti nomiga kelib tushgan murojaatlariga oid masalalar bilan bogʻliq ishlarning, shuningdek davlat siyosatini amalga oshirish masalalari boʻyicha jamoatchilik fikri monitoringining amalga oshirilishini, aholi va tadbirkorlik subyektlarining dolzarb muammolari oʻrganilishini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407639" id="-8407639">Oʻzbekiston Respublikasi Prezidentining topshirigʻiga koʻra mamlakat ichida va xalqaro munosabatlarda Oʻzbekiston Respublikasi Prezidenti manfaatlarini ifoda etadi, xalqaro muzokaralar va tadbirlarda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8407640" id="-8407640">Administratsiyaning davlat organlari va tashkilotlari bilan bogʻliq faoliyatini tartibga solishga hamda bu borada ularning faoliyatini tashkil etishga oid normativ-huquqiy hujjat tusiga ega farmoyishlarni imzolaydi;</div></div><div class="ACT_TEXT"><div name="-8407641" id="-8407641">tegishli davlat organlari va tashkilotlari rahbarlari lavozimlariga nomzodlar boʻyicha hamda ushbu lavozimdagi rahbarlarni ozod etish toʻgʻrisida Oʻzbekiston Respublikasi Prezidentiga takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407642" id="-8407642">Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan tartibga muvofiq davlat organlari va tashkilotlarining mansabdor shaxslarini lavozimga tayinlaydi hamda lavozimidan ozod etadi, shuningdek davlat kadrlar siyosati amalga oshirilishini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407643" id="-8407643">Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan masalalar boʻyicha xalqaro majburiyatlarning bajarilishini muvofiqlashtiradi;</div></div><div class="ACT_TEXT"><div name="-8407644" id="-8407644">Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan tartib asosida davlat organlari va tashkilotlarida komplayens nazorati xizmati tuzilmalarini, shuningdek ular rahbarlarining komplayens va korrupsiyaga qarshi ichki nazorat boʻyicha oʻrinbosari (maslahatchi) lavozimlarini joriy etadi va tugatadi;</div></div><div class="ACT_TEXT"><div name="-8407645" id="-8407645">Administratsiya majlislarida raislik qiladi, ularda koʻrib chiqilgan masalalar yuzasidan topshiriqlarning bayonnomalarini imzolaydi;</div></div><div class="ACT_TEXT"><div name="-8407646" id="-8407646">Administratsiyaning mansabdor shaxslarini, boshqaruv va xizmatchi xodimlarini qonunchilikda belgilangan tartibda xorijiy davlatlarga xizmat safarlariga yuboradi.</div></div><div class="ACT_TEXT"><div name="-8407647" id="-8407647">Administratsiya Rahbari qonunchilik hujjatlariga muvofiq boshqa vakolatlarga ham ega boʻlishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8407648" id="-8407648">Administratsiya Rahbari oʻziga taqdim etilgan hujjatlarni oʻrganib chiqib, takliflar tayyorlashda, Administratsiya Rahbarining topshiriqlari amalga oshirilishini tashkil etish va ijrosini nazorat qilib borishda, Administratsiya faoliyatining markazlashgan holda boshqarilishini taʼminlashda hamda boshqa vazifalarni amalga oshirishda koʻmaklashish uchun shartnoma asosida mustaqil maslahatchilarni jalb qilishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407649" id="-8407649"><b>10-modda. Administratsiyaning tarkibiy boʻlinmalari</b></div></div><div class="ACT_TEXT"><div name="-8407650" id="-8407650">Administratsiya Rahbarining kotibiyati, Oʻzbekiston Respublikasi Prezidentining qabulxonasi, Administratsiya Rahbarining oʻrinbosarlari boʻlinmalari, Oʻzbekiston Respublikasi Prezidenti maslahatchilari va vakillari boʻlinmalari, Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibiyati, Oʻzbekiston Respublikasi Prezidenti protokoli, Administratsiya departamentlari, Komplayens xizmati, Ishlar boshqarmasi va Administratsiyaning tashkiliy tuzilmasiga kiruvchi boshqa boʻlinmalar Administratsiyaning tarkibiy boʻlinmalaridir.</div></div><div class="ACT_TEXT"><div name="-8407651" id="-8407651">Administratsiya tarkibiy boʻlinmalarining asosiy vazifalari, faoliyati yoʻnalishlari va ish tartibi Administratsiya Rahbari tomonidan tasdiqlanadigan Administratsiya toʻgʻrisidagi nizom bilan belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8407652" id="-8407652">Administratsiya tarkibiy boʻlinmalarining maqsadli ish faoliyati har yili Administratsiya Rahbari tomonidan tasdiqlanadigan hamda Administratsiyaning tarkibiy boʻlinmalari uchun choraklik, yarim yillik va yillik amaliy natijalarni oʻzida aks ettiradigan Administratsiyaning faoliyat dasturiga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407653" id="-8407653">Administratsiyada ish yuritish Administratsiya Rahbari tomonidan tasdiqlanadigan Hujjatlar bilan ishlash qoidalariga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407654" id="-8407654">Oʻzbekiston Respublikasi Prezidenti hamda Administratsiya huzurida tegishli sohalar va faoliyat yoʻnalishlari boʻyicha davlat organlari va tashkilotlari tashkil etilishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407655" id="-8407655"><b>11-modda. Administratsiyaning mansabdor shaxslarini, boshqaruv va xizmatchi xodimlarini lavozimga tayinlash va lavozimidan ozod etish</b></div></div><div class="ACT_TEXT"><div name="-8407656" id="-8407656">Administratsiya Rahbari, Oʻzbekiston Respublikasi Prezidentining yordamchisi, Administratsiya Rahbarining oʻrinbosarlari, Administratsiya Rahbari kotibiyatining mudiri, Oʻzbekiston Respublikasi Prezidentining maslahatchilari, Oʻzbekiston Respublikasi Prezidentining vakillari, Administratsiyaning boshqa tarkibiy boʻlinmalari boshliqlari, Oʻzbekiston Respublikasi Prezidenti huzuridagi davlat organlari va tashkilotlari rahbarlari hamda ularning oʻrinbosarlari Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan tartib asosida lavozimga tayinlanadi va lavozimidan ozod etiladi.</div></div><div class="ACT_TEXT"><div name="-8407657" id="-8407657">Oʻzbekiston Respublikasi Prezidenti maslahatchilarining birinchi oʻrinbosarini va oʻrinbosarlarini hamda Administratsiya tarkibiy boʻlinmalari boshliqlarining birinchi oʻrinbosarini va oʻrinbosarlarini, Komplayens xizmati boshligʻini, Kanselyariya mudirini hamda Administratsiyaning boshqaruv va xizmatchi xodimlarini, shuningdek Administratsiya huzuridagi davlat organlari va tashkilotlari rahbarlarini hamda ularning oʻrinbosarlarini lavozimga tayinlash va lavozimidan ozod etish Administratsiya Rahbari tomonidan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407658" id="-8407658">Administratsiyaning mansabdor shaxslariga, boshqaruv va xizmatchi xodimlariga Administratsiya reglamentida belgilangan tartibda xizmat guvohnomasi beriladi.</div></div><div class="ACT_TEXT"><div name="-8407659" id="-8407659">Xizmat guvohnomasi xodimning Administratsiyaga mansubligini, uning shaxsini va lavozimini tasdiqlovchi hujjat hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8407660" id="-8407660">Xizmat guvohnomasi Administratsiya xodimining ushbu Konstitutsiyaviy Qonunda koʻrsatilgan huquqlarga ega ekanligini va vakolatlardan foydalanishini tasdiqlaydi.</div></div><div class="ACT_TEXT"><div name="-8407661" id="-8407661">Administratsiya huzuridagi davlat organlari va tashkilotlari xodimlari ushbu tashkilotlar rahbarlari tomonidan lavozimga tayinlanadi va lavozimidan ozod etiladi.</div></div><div class="ACT_TEXT"><div name="-8407662" id="-8407662">Administratsiya Rahbari bilan kelishilgan holda Administratsiya huzuridagi davlat organlari va tashkilotlaridagi lavozimlarga tayinlangan huquqni muhofaza qiluvchi va nazorat qiluvchi organlarning, harbiy boʻlinmalarning harbiy xizmatchilari (xodimlari) ushbu idoralarda harbiy xizmatda qoldirilishi (kadrlarning amaldagi zaxirasiga kiritilishi) mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407663" id="-8407663"><b>12-modda. Administratsiya hujjatlari</b></div></div><div class="ACT_TEXT"><div name="-8407664" id="-8407664">Administratsiya Rahbari Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari, topshiriqlari va tashabbuslari ijrosini tashkil etish maqsadida, shuningdek Administratsiya Rahbarining vakolatlariga oid masalalar boʻyicha va qonunchilik hujjatlariga muvofiq Oʻzbekiston Respublikasining butun hududida barcha davlat organlari, korxonalar, muassasalar, tashkilotlar, mansabdor shaxslar tomonidan bajarilishi majburiy boʻlgan farmoyishlar yoki topshiriqlar chiqaradi.</div></div><div class="ACT_TEXT"><div name="-8407665" id="-8407665">Administratsiya Rahbarining farmoyishlari, agar ularning oʻzida kechroq muddat koʻrsatilmagan boʻlsa, imzolangan kundan eʼtiboran kuchga kiradi.</div></div><div class="ACT_TEXT"><div name="-8407666" id="-8407666">Oʻzbekiston Respublikasi Prezidenti Administratsiya Rahbarining farmoyishlari va topshiriqlarini toʻxtatib turishi, bekor qilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8407667" id="-8407667">Administratsiya Rahbari oʻzi qabul qilgan hujjatlarning bajarilishi ustidan nazoratni bevosita, Administratsiya tarkibiy boʻlinmalari rahbarlari yoki respublika ijro etuvchi hokimiyat organlari orqali amalga oshiradi.</div></div><div class="ACT_TEXT"><div name="-8407668" id="-8407668">Administratsiya Rahbarining farmoyishlari va topshiriqlarini ishlab chiqish, kelishish va Administratsiya Rahbariga imzolash uchun kiritish hamda Administratsiya Rahbarining farmoyishlarini eʼlon qilish tartibi Administratsiyaning reglamentida belgilanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407669" id="-8407669"><b>13-modda. Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari loyihalarini ishlab chiqish, Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlarining ijrosini tashkil etish hamda monitoring qilish</b></div></div><div class="ACT_TEXT"><div name="-8407670" id="-8407670">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari loyihalari qonunchilik hujjatlarining ijrosi yuzasidan, Oʻzbekiston Respublikasi Prezidentining yoki Administratsiya Rahbarining topshirigʻiga koʻra, shuningdek davlat organlari va tashkilotlarining tashabbusi boʻyicha, ushbu organlar va tashkilotlar zimmasiga yuklatilgan vazifalarning ijrosi yuzasidan ishlab chiqiladi.</div></div><div class="ACT_TEXT"><div name="-8407671" id="-8407671">Administratsiya Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari loyihalarini mustaqil ravishda ishlab chiqishga haqli.</div></div><div class="ACT_TEXT"><div name="-8407672" id="-8407672">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari loyihalarini tayyorlash, koʻrib chiqish, imzolash hamda eʼlon qilish Administratsiyaning reglamentiga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407673" id="-8407673">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari loyihalarini vazirliklar va idoralar tomonidan ishlab chiqish, kelishish hamda Administratsiyaga kiritish qonunchilik hujjatlarida belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407674" id="-8407674">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlari ijrosini tashkil etish, nazorat qilish hamda bajarish yuzasidan ijro intizomining holatini tizimli ravishda va tanqidiy jihatdan tahlil qilish qonunchilik hujjatlariga hamda Administratsiyaning reglamentiga muvofiq amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407675" id="-8407675">Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlari ijrosini nazorat qilish qonunchilik hujjatlarida belgilangan tartibda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407676" id="-8407676">Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari, farmoyishlari va topshiriqlarining, Administratsiya Rahbari farmoyishlari va topshiriqlarining ijrosini taʼminlash boʻyicha ishlarni bevosita nazorat qilish hamda muvofiqlashtirish maqsadida Administratsiya Rahbari barcha darajadagi davlat organlari va tashkilotlarida hamda Oʻzbekiston Respublikasining xorijiy davlatlardagi diplomatik muassasalarida Administratsiya Rahbarining vakili lavozimini zaruratga koʻra joriy etishga haqli.</div></div><div class="ACT_TEXT"><div name="-8407677" id="-8407677">Administratsiya Rahbarining vakillari Administratsiya Rahbari tomonidan lavozimga tayinlanadi va lavozimidan ozod etiladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407678" id="-8407678"><b>14-modda. Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi faoliyatini tashkil etish</b></div></div><div class="ACT_TEXT"><div name="-8407679" id="-8407679">Huquqni muhofaza qiluvchi va nazorat qiluvchi organlar, kuch ishlatishga vakolatli tuzilmalar hamda harbiy tuzilmalar, shuningdek tashqi ishlar siyosati uchun masʼul idoralar Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi tarkibiga kiritiladi hamda mazkur kengash ularning asosiy faoliyatini maqsadli boshqaruvchi va uygʻunlikdagi hamkorligini taʼminlovchi oliy muvofiqlashtiruvchi organ hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8407680" id="-8407680">Oʻzbekiston Respublikasi Prezidenti Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashining raisi hisoblanadi hamda unga boshchilik qiladi.</div></div><div class="ACT_TEXT"><div name="-8407681" id="-8407681">Administratsiya Rahbari Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi raisining oʻrinbosari hisoblanadi hamda ushbu kengash aʼzolarining faoliyatini tashkil etadi va muvofiqlashtiradi.</div></div><div class="ACT_TEXT"><div name="-8407682" id="-8407682">Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashining ishchi organi Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibiyati hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-8407683" id="-8407683">Administratsiya Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashi kotibiyati orqali Oʻzbekiston Respublikasi Prezidentining Qurolli Kuchlarga, mudofaaga, safarbarlikka, xavfsizlikka va favqulodda vaziyatlarga oid konstitutsiyaviy vakolatlarini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-8407684" id="-8407684">Oʻzbekiston Respublikasi Prezidenti huzuridagi Xavfsizlik kengashining faoliyatini tashkil etish va muvofiqlashtirish tartibi qonunchilik hujjatlariga muvofiq belgilanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407685" id="-8407685"><b>15-modda. Oʻzbekiston Respublikasi Prezidenti tomonidan ustuvor yoki strategik deb belgilangan investitsiya, infratuzilma, sanoat, energetika, transport boʻyicha loyihalarning, ijtimoiy va boshqa loyihalarning amalga oshirilishini muvofiqlashtirish, monitoring va nazorat qilish</b></div></div><div class="ACT_TEXT"><div name="-8407686" id="-8407686">Administratsiya Oʻzbekiston Respublikasi Prezidenti tomonidan ustuvor yoki strategik deb belgilangan investitsiya, infratuzilma, sanoat, energetika, transport boʻyicha loyihalarning, ijtimoiy va boshqa loyihalarning oʻz vaqtida, sifatli hamda natijali tarzda amalga oshirilishini muvofiqlashtiradi, monitoring va nazorat qiladi.</div></div><div class="ACT_TEXT"><div name="-8407687" id="-8407687">Oʻzbekiston Respublikasi Prezidenti tomonidan ustuvor yoki strategik deb belgilangan investitsiya, infratuzilma, sanoat, energetika, transport boʻyicha loyihalarning, ijtimoiy va boshqa loyihalarning roʻyxati, ularning maqsadli koʻrsatkichlari, asosiy bosqichlari hamda yakuniy muddatlari Oʻzbekiston Respublikasi Prezidentining farmonlariga, qarorlariga, farmoyishlariga yoki topshirigʻiga asosan Administratsiya Rahbari tomonidan tasdiqlanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407688" id="-8407688"><b>16-modda. Administratsiyaning Oliy Majlis palatalari bilan hamkorligi</b></div></div><div class="ACT_TEXT"><div name="-8407689" id="-8407689">Administratsiya Oliy Majlis palatalari bilan hamkorlik doirasida:</div></div><div class="ACT_TEXT"><div name="-8407690" id="-8407690">Oliy Majlis palatalari bilan davlat siyosatining ustuvor yoʻnalishlari boʻyicha doimiy muloqotni taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407691" id="-8407691">Oʻzbekiston Respublikasi Prezidentining qonunchilik tashabbusi huquqi amalga oshirilishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407692" id="-8407692">Oʻzbekiston Respublikasi Prezidenti tomonidan Oliy Majlis palatalariga kiritiladigan dasturiy hujjatlarni va boshqa masalalarni tayyorlashni muvofiqlashtiradi;</div></div><div class="ACT_TEXT"><div name="-8407693" id="-8407693">Oʻzbekiston Respublikasi Prezidentining tegishliligi boʻyicha Oliy Majlis palatalariga Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasiga </a>va boshqa qonunchilik hujjatlariga muvofiq taqdim etadigan lavozimlarga nomzodlar hamda boshqa masalalar boʻyicha vakolatlarini tashkiliy, huquqiy va tahliliy jihatdan taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407694" id="-8407694">Oʻzbekiston Respublikasi Oliy Majlisi tomonidan Oʻzbekiston Respublikasi Prezidentiga qonun hujjatlarida belgilangan tartibda yuborilgan qonunlarning Oʻzbekiston Respublikasi Prezidentiga koʻrib chiqish uchun taqdim etilishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407695" id="-8407695">Oʻzbekiston Respublikasi Prezidentining qonunni oʻz eʼtirozlari bilan Oʻzbekiston Respublikasi Oliy Majlisiga qaytarishga oid huquqi amalga oshirilishini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-8407696" id="-8407696">Administratsiyaning Oliy Majlis palatalari bilan hamkorligi qonunchilik hujjatlarida va Administratsiyaning reglamentida nazarda tutilgan boshqa masalalar boʻyicha ham amalga oshirilishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407697" id="-8407697"><b>17-modda. Administratsiyaning Oʻzbekiston Respublikasi Vazirlar Mahkamasi va uning boʻysunuvidagi davlat organlari hamda tashkilotlari bilan aloqalari</b></div></div><div class="ACT_TEXT"><div name="-8407698" id="-8407698">Administratsiya Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi Vazirlar Mahkamasi (bundan buyon matnda Vazirlar Mahkamasi deb yuritiladi) va uning boʻysunuvidagi davlat organlari hamda tashkilotlari bilan aloqalari doirasida:</div></div><div class="ACT_TEXT"><div name="-8407699" id="-8407699">Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari, farmoyishlari va topshiriqlarining ijrosini tashkil etish doirasida Vazirlar Mahkamasi hamda uning boʻysunuvidagi davlat organlari va tashkilotlarining idoralararo hamkorligini muvofiqlashtiradi, mazkur hujjatlarning ijrosini monitoring qiladi va nazoratini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407700" id="-8407700">Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi xalqiga hamda Oliy Majlisiga murojaatnomasida bayon etilgan topshiriqlarning Vazirlar Mahkamasi va uning boʻysunuvidagi davlat organlari hamda tashkilotlari tomonidan samarali ijro etilishini taʼminlash chora-tadbirlarining monitoringini tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407701" id="-8407701">Oʻzbekiston Respublikasi Prezidentining respublika ijro etuvchi hokimiyat organlarini tuzish hamda tugatish, ularning rahbarlarini qonunchilik hujjatlariga muvofiq lavozimga tayinlash va lavozimidan ozod etish, respublika ijro etuvchi hokimiyat organlarining hujjatlarini toʻxtatish, bekor qilish boʻyicha vakolatlarini tashkiliy, huquqiy va tahliliy jihatdan taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407702" id="-8407702">milliy rivojlanish strategiyalari, davlat dasturlari va milliy loyihalarning respublika ijro etuvchi hokimiyat organlari tomonidan amalga oshirilishi boʻyicha monitoringni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407703" id="-8407703">Vazirlar Mahkamasi va uning boʻysunuvidagi davlat organlari hamda tashkilotlari faoliyati samaradorligini tahlil qilishda ishtirok etadi;</div></div><div class="ACT_TEXT"><div name="-8407704" id="-8407704">Oʻzbekiston Respublikasi Prezidenti ishtirokida oʻtkaziladigan Vazirlar Mahkamasi faoliyatiga oid yigʻilishlar va muhokamalarning tashkiliy, huquqiy va tahliliy jihatdan tayyorlanishini taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407705" id="-8407705">Oʻzbekiston Respublikasi Bosh vaziri tomonidan kadrlar siyosatiga oid takliflarning Oʻzbekiston Respublikasi Prezidentiga qonunchilik hujjatlariga muvofiq taqdim etilishini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-8407706" id="-8407706">Administratsiya Rahbari yoki Administratsiyaning vakolat berilgan mansabdor shaxsi Vazirlar Mahkamasi, uning Rayosati, komissiyalari, kengashlari, davlat organlari va tashkilotlarining hayʼatlari hamda boshqa kollegial organlari majlislarida oʻz fikr va mulohazalari bilan ishtirok etishga haqli.</div></div><div class="ACT_TEXT"><div name="-8407707" id="-8407707">Administratsiyaning Vazirlar Mahkamasi bilan aloqalari qonunchilik hujjatlarida va Administratsiyaning reglamentida nazarda tutilgan boshqa masalalar boʻyicha ham amalga oshirilishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407708" id="-8407708"><b>18-modda. Administratsiyaning Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari bilan aloqalari</b></div></div><div class="ACT_TEXT"><div name="-8407709" id="-8407709">Administratsiya Oʻzbekiston Respublikasi Prezidentining hududlarni ijtimoiy-iqtisodiy rivojlantirish borasidagi farmonlari, qarorlari, farmoyishlari va topshiriqlari ijrosini taʼminlash hamda davlat siyosatini amalga oshirish masalalari boʻyicha Qoraqalpogʻiston Respublikasi Vazirlar Kengashi faoliyatiga koʻmaklashadi, viloyatlar va Toshkent shahar hokimliklari faoliyatini muvofiqlashtiradi, monitoring va nazorat qiladi.</div></div><div class="ACT_TEXT"><div name="-8407710" id="-8407710">Administratsiya:</div></div><div class="ACT_TEXT"><div name="-8407711" id="-8407711">Oʻzbekiston Respublikasi Prezidenti farmonlari, qarorlari, farmoyishlari va topshiriqlarining hududlarda ijro etilishi yuzasidan monitoringni tashkil etadi;</div></div><div class="ACT_TEXT"><div name="-8407712" id="-8407712">Oʻzbekiston Respublikasi Prezidentining viloyatlar hokimlarini va Toshkent shahar hokimini tayinlash hamda lavozimidan ozod etish, Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasini</a>, qonunlarini buzgan yoki hokimning shaʼni va qadr-qimmatiga dogʻ tushiradigan xatti-harakatlar sodir etgan tuman va shahar hokimlarini lavozimidan ozod etish, hokimlarning hujjatlarini toʻxtatish, bekor qilish boʻyicha vakolatlari amalga oshirilishini tashkiliy, huquqiy va tahliliy jihatdan taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407713" id="-8407713">hududlarni ijtimoiy-iqtisodiy rivojlantirish holatini monitoring qiladi;</div></div><div class="ACT_TEXT"><div name="-8407714" id="-8407714">hududlarning iqtisodiy, ijtimoiy, infratuzilmaviy va ekologik rivojlanish holati, aholining turmush darajasi hamda hududlar oʻrtasidagi tafovutlar tizimli ravishda tahlil qilinishini taʼminlaydi, aniqlangan muammolarning yechimi boʻyicha Oʻzbekiston Respublikasi Prezidentiga asoslangan takliflar kiritadi;</div></div><div class="ACT_TEXT"><div name="-8407715" id="-8407715">Oʻzbekiston Respublikasi Prezidentining hududlarni ijtimoiy-iqtisodiy rivojlantirishga doir tashriflari, yigʻilishlari va qarorlarini tayyorlashni, respublika ijro etuvchi hokimiyat organlari hamda mahalliy ijro etuvchi hokimiyat organlari oʻrtasidagi hamkorlikni tashkil etadi.</div></div><div class="ACT_TEXT"><div name="-8407716" id="-8407716">Administratsiyaning Oʻzbekiston Respublikasi Prezidentining Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar hokimliklari faoliyatiga oid vakolatlarini tashkil etish hamda taʼminlashga oid boshqa masalalar qonunchilik hujjatlarida va Administratsiyaning reglamentida belgilangan tartibga muvofiq amalga oshiriladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407717" id="-8407717"><b>19-modda. Administratsiyaning sud hokimiyati va sudyalar hamjamiyati organlari bilan hamkorligi</b></div></div><div class="ACT_TEXT"><div name="-8407718" id="-8407718">Administratsiya sud hokimiyati va sudyalar hamjamiyati organlari bilan hamkorlik doirasida:</div></div><div class="ACT_TEXT"><div name="-8407719" id="-8407719">Oʻzbekiston Respublikasi Prezidentiga hamkorlikka oid masalalar boʻyicha takliflar va tahliliy materiallar tayyorlaydi;</div></div><div class="ACT_TEXT"><div name="-8407720" id="-8407720">Oʻzbekiston Respublikasi Prezidentining Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-6445145">Konstitutsiyasida </a>nazarda tutilgan sud hokimiyati va sudyalar hamjamiyati organlari bilan hamkorligiga oid vakolatlarini tashkiliy, huquqiy va tahliliy jihatdan taʼminlaydi;</div></div><div class="ACT_TEXT"><div name="-8407721" id="-8407721">sud-huquq sohasidagi islohotlarni muvofiqlashtiradi;</div></div><div class="ACT_TEXT"><div name="-8407722" id="-8407722">sud tizimini isloh qilishga doir takliflarni ishlab chiqadi;</div></div><div class="ACT_TEXT"><div name="-8407723" id="-8407723">sudlar va sudyalar hamjamiyati organlari faoliyati uchun zarur tashkiliy va huquqiy shart-sharoitlarni yaxshilash boʻyicha takliflar ishlab chiqilishini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-8407724" id="-8407724">Administratsiya qonunchilik hujjatlarida nazarda tutilgan boshqa masalalar boʻyicha ham sud hokimiyati va sudyalar hamjamiyati organlari bilan hamkorlikni amalga oshirishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407725" id="-8407725"><b>20-modda. Administratsiyaning Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari bilan aloqalari</b></div></div><div class="ACT_TEXT"><div name="-8407726" id="-8407726">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlarining, mansabdor shaxslarning faoliyatini qonunchilik hujjatlariga binoan muvofiqlashtirish va uning natijadorligini baholashni tashkil etish Administratsiya tomonidan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407727" id="-8407727">Administratsiya Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlarining, mansabdor shaxslarning faoliyatini muvofiqlashtirish doirasida:</div></div><div class="ACT_TEXT"><div name="-8407728" id="-8407728">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlarining, mansabdor shaxslarning faoliyati samaradorligini tahlil qiladi, sohalarga oid davlat siyosatini amalga oshirish monitoringini olib boradi;</div></div><div class="ACT_TEXT"><div name="-8407729" id="-8407729">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlari mansabdor shaxslarining hisobotlarini oʻz vakolatlari doirasida koʻrib chiqadi, ularning faoliyatini baholaydi va uning samaradorligini oshirish boʻyicha chora-tadbirlarni belgilaydi;</div></div><div class="ACT_TEXT"><div name="-8407730" id="-8407730">Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlarining, mansabdor shaxslarning faoliyatini takomillashtirish boʻyicha takliflar tayyorlaydi hamda Oʻzbekiston Respublikasi Prezidentiga kiritadi.</div></div><div class="ACT_TEXT"><div name="-8407731" id="-8407731">Administratsiya Oʻzbekiston Respublikasi Prezidentiga bevosita boʻysunuvchi (hisobdor) davlat organlari va tashkilotlarining, mansabdor shaxslarning faoliyatini qonunchilik hujjatlarida nazarda tutilgan boshqa yoʻnalishlar boʻyicha ham muvofiqlashtiradi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407732" id="-8407732"><b>21-modda. Administratsiyaning davlat organlari va tashkilotlarining komplayens va korrupsiyaga qarshi ichki nazorat tuzilmalari bilan aloqalari</b></div></div><div class="ACT_TEXT"><div name="-8407733" id="-8407733">Davlat organlari va tashkilotlarida korrupsiyaga qarshi kurashish samaradorligini oshirish, manfaatlar toʻqnashuvining hamda korrupsiyaviy holatlarning oldini olish choralarini kuchaytirish maqsadida tashkil etiladigan davlat organlari va tashkilotlarining komplayens va korrupsiyaga qarshi ichki nazorat tuzilmalari faoliyati Administratsiyaning Komplayens xizmati tomonidan muvofiqlashtiriladi.</div></div><div class="ACT_TEXT"><div name="-8407734" id="-8407734">Respublika darajasidagi davlat organlari va tashkilotlari rahbarlarining komplayens va korrupsiyaga qarshi ichki nazorat boʻyicha oʻrinbosarlari (maslahatchilari) Administratsiya Rahbari tomonidan lavozimga tayinlanadi va lavozimidan ozod etiladi hamda ular oʻz faoliyati davomida Administratsiyaning vakili maqomiga ega boʻladi.</div></div><div class="ACT_TEXT"><div name="-8407735" id="-8407735">Administratsiya Komplayens xizmatining davlat organlari va tashkilotlarining komplayens va korrupsiyaga qarshi ichki nazorat tuzilmalari bilan aloqalari Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan tartibda hamda “Korrupsiyaga qarshi kurashish toʻgʻrisida”gi Oʻzbekiston Respublikasi <a href="https://lex.uz/uz/docs/-3088008">Qonuniga </a>muvofiq amalga oshiriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8407736" id="-8407736"><b>3-bob. Administratsiyaning mansabdor shaxslari, boshqaruv va xizmatchi xodimlari faoliyatining kafolatlari</b></div></div><div class="CLAUSE_DEFAULT"><div name="-8407737" id="-8407737"><b>22-modda. Administratsiyaning mansabdor shaxslarini, boshqaruv va xizmatchi xodimlarini moddiy ragʻbatlantirish</b></div></div><div class="ACT_TEXT"><div name="-8407738" id="-8407738">Administratsiya mansabdor shaxslarining, boshqaruv va xizmatchi xodimlarining ish haqi lavozim maoshidan hamda qonunchilik hujjatlarida nazarda tutilgan boshqa toʻlovlardan iboratdir.</div></div><div class="ACT_TEXT"><div name="-8407739" id="-8407739">Administratsiyaning mansabdor shaxslarini, boshqaruv va xizmatchi xodimlarini moddiy ragʻbatlantirish qonunchilik hujjatlariga muvofiq amalga oshiriladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407740" id="-8407740"><b>23-modda. Administratsiya mansabdor shaxslarining, boshqaruv va xizmatchi xodimlarining ijtimoiy taʼminoti</b></div></div><div class="ACT_TEXT"><div name="-8407741" id="-8407741">Administratsiyaning mansabdor shaxslariga, boshqaruv va xizmatchi xodimlariga haq toʻlanadigan yillik taʼtillar beriladi.</div></div><div class="ACT_TEXT"><div name="-8407742" id="-8407742">Administratsiyaning ishlash uchun boshqa hududlardan taklif qilingan hamda Toshkent shahrida uy-joyga ega boʻlmagan mansabdor shaxslariga, boshqaruv va xizmatchi xodimlariga lavozimda boʻlish vaqtida zaruratga koʻra, ularning arizasiga binoan xizmat uy-joyi beriladi.</div></div><div class="ACT_TEXT"><div name="-8407743" id="-8407743">Administratsiyaning mansabdor shaxslarini, boshqaruv va xizmatchi xodimlarini ijtimoiy himoya qilish tizimi kafolatlangan tibbiy yordamdan hamda sanatoriy-sogʻlomlashtirish xizmatlaridan ushbu mansabdor shaxslar, xodimlar va ularning oila aʼzolari (turmush oʻrtogʻi, farzandlari va ota-onasi) tomonidan foydalanish hamda boshqa ijtimoiy yordam koʻrsatish orqali amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-8407744" id="-8407744">Administratsiyaning mansabdor shaxslari, boshqaruv va xizmatchi xodimlari uchun avvalgi ish joyida berilgan harbiy va maxsus unvonlar (martaba (malaka) darajalari, malaka toifalari, diplomatik darajalar va boshqalar) uchun berilgan ustamalar va qoʻshimcha toʻlovlar saqlab qolinadi.</div></div><div class="ACT_TEXT"><div name="-8407745" id="-8407745">Administratsiya mansabdor shaxslarining, boshqaruv va xizmatchi xodimlarining Administratsiyadagi uzoq muddatli xizmatlari uchun qoʻshimcha ustamalar belgilashda ularning boshqa organlar, tashkilotlar va muassasalardagi ish staji (xizmat davri) inobatga olinadi.</div></div><div class="ACT_TEXT"><div name="-8407746" id="-8407746">Administratsiyaning mansabdor shaxslari, boshqaruv va xizmatchi xodimlari avvalgi ish joyi boʻyicha xodimlar uchun belgilangan barcha imtiyozlar, moddiy va ijtimoiy himoya choralaridan Administratsiya tarkibiy boʻlinmalarida amalda boʻlgan mehnat sharoitlari hisobga olingan holda hamda lavozim maoshi va boshqa toʻlovlar miqdorlari saqlangan holda foydalanadi.</div></div><div class="ACT_TEXT"><div name="-8407747" id="-8407747">Administratsiyaning tarkibiy boʻlinmalarida ishlangan davr harbiy va maxsus unvonlarni (martaba (malaka) darajalarini, malaka toifalarini, diplomatik darajalarni va boshqalarni) olish uchun zarur boʻlgan ish stajiga qoʻshiladi.</div></div><div class="ACT_TEXT"><div name="-8407748" id="-8407748">Qonunchilik hujjatlariga muvofiq Administratsiyaning mansabdor shaxslari, boshqaruv va xizmatchi xodimlari uchun qoʻshimcha ijtimoiy taʼminot choralari belgilanishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407749" id="-8407749"><b>24-modda. Administratsiyaning mansabdor shaxslarini va boshqaruv xodimlarini huquqiy jihatdan himoya qilish kafolatlari</b></div></div><div class="ACT_TEXT"><div name="-8407750" id="-8407750">Administratsiyaning mansabdor shaxslari va boshqaruv xodimlari oʻz zimmasiga yuklatilgan vazifalarni bajarishi chogʻida davlat himoyasida boʻladi.</div></div><div class="ACT_TEXT"><div name="-8407751" id="-8407751">Administratsiya mansabdor shaxslarining va boshqaruv xodimlarining oʻz zimmasiga yuklatilgan vazifalarni bajarishiga monelik qilish, ularning shaʼni va qadr-qimmatini haqorat qilish, ularga nisbatan tahdid yoki zoʻrlik qilish, oʻz faoliyatini amalga oshirishi munosabati bilan ularning hayotiga, sogʻligʻiga va mol-mulkiga tajovuz qilish qonunda belgilangan javobgarlikka sabab boʻladi.</div></div><div class="ACT_TEXT"><div name="-8407752" id="-8407752">Administratsiyaning mansabdor shaxslariga va ularning oila aʼzolariga (turmush oʻrtogʻiga, farzandlariga va ota-onasiga) umrbod, Administratsiyaning boshqaruv xodimlariga Administratsiyadagi faoliyati davriga Oʻzbekiston Respublikasi Prezidenti tomonidan belgilangan tartibda biometrik diplomatik pasportlar beriladi.</div></div><div class="ACT_TEXT"><div name="-8407753" id="-8407753">Administratsiyaning mansabdor shaxslari va boshqaruv xodimlari hamda ularning oila aʼzolari (turmush oʻrtogʻi, farzandlari va ota-onasi) xavfsizligini taʼminlash Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadigan tartibda amalga oshiriladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407754" id="-8407754"><b>25-modda. Administratsiya mansabdor shaxslarining va boshqaruv xodimlarining daxlsizlik kafolatlari</b></div></div><div class="ACT_TEXT"><div name="-8407755" id="-8407755">Administratsiyaning mansabdor shaxslari va boshqaruv xodimlari daxlsizlikka hamda immunitetga ega boʻladi.</div></div><div class="ACT_TEXT"><div name="-8407756" id="-8407756">Administratsiya mansabdor shaxslarining va boshqaruv xodimlarining daxlsizligi ularning va ular oila aʼzolarining (turmush oʻrtogʻining, farzandlarining va ota-onasining) shaxsiy hayotiga, turar joyiga, xizmat xonasiga, ular foydalanadigan shaxsiy va xizmat transport vositasiga hamda aloqa va kommunikatsiya vositasiga, xat-xabarlariga, yozishmalariga, elektron maʼlumotlariga, ularga tegishli ashyolar va hujjatlarga nisbatan tatbiq etiladi.</div></div><div class="ACT_TEXT"><div name="-8407757" id="-8407757">Administratsiyaning mansabdor shaxslariga nisbatan jinoyat ishi qoʻzgʻatishga, ularni jinoiy javobgarlikka tortishga, ularning huquqlari va erkinliklarini cheklaydigan boshqa har qanday protsessual majburlov choralarini qoʻllashga, tezkor-qidiruv faoliyatini amalga oshirishga, surishtiruv, tergov harakatlari oʻtkazishga yoki maʼmuriy qamoq jazo chorasini qoʻllashga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-8407758" id="-8407758">Administratsiyaning boshqaruv xodimlari oʻz zimmasiga yuklatilgan vazifalarni bajarish hamda vakolatlarini amalga oshirish bilan bogʻliq holda qabul qilgan qarorlari, sodir etgan harakatlari yoki harakatsizligi, bildirgan fikrlari va bergan koʻrsatmalari uchun jinoiy, maʼmuriy yoki fuqaroviy javobgarlikka tortilmaydi.</div></div><div class="ACT_TEXT"><div name="-8407759" id="-8407759">Administratsiyada oʻz zimmasiga yuklatilgan vazifalarni bajarish hamda vakolatlarini amalga oshirish bilan bogʻliq boʻlmagan harakat yoki harakatsizlik uchun Administratsiyaning boshqaruv xodimlariga nisbatan Oʻzbekiston Respublikasi Prezidentining yozma roziligisiz jinoyat ishini qoʻzgʻatish, ularni jinoiy javobgarlikka tortish, ularning huquqlari va erkinliklarini cheklaydigan boshqa har qanday protsessual majburlov choralarini qoʻllash, tezkor-qidiruv faoliyatini amalga oshirish, surishtiruv, tergov harakatlari oʻtkazish yoki sud tartibida maʼmuriy jazo va huquqiy taʼsir choralarini qoʻllashga yoʻl qoʻyilmaydi.</div></div><div class="ACT_TEXT"><div name="-8407760" id="-8407760">Administratsiyaning boshqaruv xodimi Administratsiyada ishlab turganida va (yoki) ishdan boʻshatilganidan keyin unga nisbatan jinoyat ishi faqat Oʻzbekiston Respublikasi Bosh prokurori tomonidan qoʻzgʻatilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8407761" id="-8407761">Administratsiyaning boshqaruv xodimiga nisbatan Administratsiyada ishlab turganida va (yoki) ishdan boʻshatilganidan keyin qoʻzgʻatilgan jinoyat ishi Oʻzbekiston Respublikasi Oliy sudining sudloviga tegishlidir.</div></div><div class="ACT_TEXT"><div name="-8407762" id="-8407762">Administratsiyaning mansabdor shaxslari, boshqaruv va xizmatchi xodimlari qonunchilik hujjatlariga muvofiq tezkor-qidiruv faoliyatini amalga oshiruvchi vakolatli davlat organlari tomonidan maxfiylik asosida hamkorlikka jalb qilinishi, shu jumladan Administratsiyadan boʻshatilganidan keyin ham jalb qilinishi taqiqlanadi.</div></div><div class="ACT_TEXT"><div name="-8407763" id="-8407763">Administratsiyaning mansabdor shaxslari ushbu Konstitutsiyaviy Qonunda belgilangan daxlsizlik va immunitetni Administratsiyadan boʻshatilganidan keyin umrbod, boshqaruv xodimlari esa Administratsiyadan boʻshatilganidan keyin besh yil davomida saqlab qoladi.</div></div><div class="ACT_TEXT"><div name="-8407764" id="-8407764">Ushbu moddada belgilangan qoidalarni buzgan holda olingan dalillar qonun hujjatlarini buzgan holda olingan deb hisoblanadi va nomaqbul dalillar deb topiladi.</div></div><div class="ACT_TEXT"><div name="-8407765" id="-8407765">Qonunchilik hujjatlariga ushbu moddada nazarda tutilgan daxlsizlikka oid qoidalarni bekor qilishga, ogʻirlashtirishga yoki daxlsizlik qoʻllaniladigan shaxslarning holatini yomonlashtirishga olib keladigan oʻzgartirish va qoʻshimchalar kiritilgan taqdirda, bunday oʻzgartirishlar Administratsiyaning ushbu Konstitutsiyaviy Qonunda belgilangan qoidalar qoʻllaniladigan mansabdor shaxslariga va boshqaruv xodimlariga nisbatan tatbiq etilmaydi, shu jumladan ular Administratsiyadan boʻshatilganidan keyin ham tatbiq etilmaydi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407766" id="-8407766"><b>26-modda. Administratsiyaning mansabdor shaxslarini va boshqaruv xodimlarini ishga joylashtirish kafolatlari</b></div></div><div class="ACT_TEXT"><div name="-8407767" id="-8407767">Administratsiyaning mansabdor shaxslari va boshqaruv xodimlari Administratsiyadagi lavozimidan ozod etilgan hollarda ularga Administratsiyaga ishga kelguniga qadar egallab turgan avvalgi lavozimidan kamida bir pogʻona yuqori darajadagi lavozim beriladi, avvalgi lavozimidan yuqori lavozim mavjud (boʻsh) boʻlmaganda esa avvalgi lavozimiga teng lavozimi yoki ularning mutaxassisligi hisobga olingan holda Oʻzbekiston Respublikasi davlat organlari va tashkilotlaridagi kamida bir pogʻona yuqori yoki teng darajadagi lavozim birinchi navbatda beriladi, bundan saylanadigan yoki Oʻzbekiston Respublikasi Prezidentining farmonlari va qarorlari bilan tayinlanadigan lavozimlardan Administratsiyaga ishga oʻtganlik, mehnat intizomini buzganlik uchun ishdan boʻshatilish hollari mustasno.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-8407768" id="-8407768"><b>4-bob. Yakunlovchi qoidalar</b></div></div><div class="CLAUSE_DEFAULT"><div name="-8407769" id="-8407769"><b>27-modda. Administratsiyaning faoliyatini moliyalashtirish</b></div></div><div class="ACT_TEXT"><div name="-8407770" id="-8407770">Administratsiyaning faoliyati Oʻzbekiston Respublikasining respublika budjeti mablagʻlari, shuningdek qonunchilik hujjatlarida taqiqlanmagan boshqa manbalar hisobidan moliyalashtiriladi.</div></div><div class="ACT_TEXT"><div name="-8407771" id="-8407771">Administratsiyada budjetdan tashqari jamgʻarmalar tuzilishi mumkin, ularni shakllantirish va ulardan foydalanish tartibi qonunchilik hujjatlariga muvofiq belgilanadi.</div></div><div class="ACT_TEXT"><div name="-8407772" id="-8407772">Administratsiya qonunchilik hujjatlarida belgilangan tartibda shakllantiriladigan xizmat uy-joy fondiga ega boʻlishi mumkin.</div></div><div class="ACT_TEXT"><div name="-8407773" id="-8407773">Administratsiya oʻz faoliyatini amalga oshirish uchun axborot-kommunikatsiya tizimlarini va axborot bazalarini, shuningdek axborotning himoya vositalarini, shu jumladan kriptografik himoya vositalarini ishlab chiqadi, yaratadi hamda ulardan foydalanadi, Oʻzbekiston Respublikasi davlat organlari va tashkilotlarining shu kabi tizimlaridan va axborot bazalaridan Administratsiya ishini samarali ravishda amalga oshirish maqsadida, qonunchilik hujjatlarida belgilangan tartibda foydalanadi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407774" id="-8407774"><b>28-modda. Administratsiyada maʼlumotlarni himoya qilish</b></div></div><div class="ACT_TEXT"><div name="-8407775" id="-8407775">Administratsiyada davlat sirlarini tashkil etuvchi maʼlumotlarning himoya qilinishi, shu jumladan kriptografik vositalarni qoʻllagan holda texnik jihatdan himoya qilinishi taʼminlanadi.</div></div><div class="ACT_TEXT"><div name="-8407776" id="-8407776">Administratsiyada maxfiy ish yuritish davlat sirlari toʻgʻrisidagi qonunchilikka muvofiq amalga oshiriladi. Bunda Administratsiyada maxfiylik rejimini taʼminlash, unga rioya etilishi ustidan nazoratni tashkil etish hamda tegishli normativ-huquqiy hujjatlar talablarini bajarish yuzasidan tekshirish tadbirlarini oʻtkazish Administratsiyaning Komplayens xizmati tomonidan amalga oshiriladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407777" id="-8407777"><b>29-modda. Administratsiyaning hujjatlari ustidan, Administratsiya mansabdor shaxslarining, boshqaruv va xizmatchi xodimlarining harakatlari (harakatsizligi) ustidan shikoyat qilish</b></div></div><div class="ACT_TEXT"><div name="-8407778" id="-8407778">Administratsiyaning hujjatlari ustidan, Administratsiya mansabdor shaxslarining, boshqaruv va xizmatchi xodimlarining harakatlari (harakatsizligi) ustidan qonunda belgilangan tartibda shikoyat qilinishi mumkin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407779" id="-8407779"><b>30-modda. Administratsiya toʻgʻrisidagi qonunchilikni buzganlik uchun javobgarlik</b></div></div><div class="ACT_TEXT"><div name="-8407780" id="-8407780">Administratsiya toʻgʻrisidagi qonunchilikni buzganlikda aybdor shaxslar belgilangan tartibda javobgar boʻladi.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407781" id="-8407781"><b>31-modda. Oʻzbekiston Respublikasining ayrim qonun hujjatlariga oʻzgartirish va qoʻshimchalar kiritish</b></div></div><div class="ACT_TEXT"><div name="-8407782" id="-8407782">1. Oʻzbekiston Respublikasining 1993-yil 2-sentabrda qabul qilingan “Mahalliy davlat hokimiyati toʻgʻrisida”gi 913-XII-sonli Qonuni (Oʻzbekiston Respublikasi Oliy Kengashining Axborotnomasi, 1993-yil, № 9, 320-modda; Oʻzbekiston Respublikasi Oliy Majlisining Axborotnomasi, 1997-yil, № 9, 241-modda; 1999-yil, № 1, 20-modda; 2005-yil, № 1, 18-modda; Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2005-yil, № 12, 418-modda; 2007-yil, № 4, 163-modda, № 9, 420-modda; 2008-yil, № 12, 640-modda; 2013-yil, № 12, 350-modda; 2014-yil, № 4, 86-modda, № 5, 130-modda; 2015-yil, № 6, 228-modda; 2017-yil, № 6, 300-modda, № 8, 383-modda, № 9, 510-modda, № 12, 772-modda; 2018-yil, № 7, 431-modda; 2019-yil, № 1, 4-modda, № 11, 792-modda, № 12, 891-modda; 2020-yil, № 9, 537-modda; 2021-yil, № 1, 3, 7, 13-moddalar, 4-songa ilova, № 8, 800-modda, № 12, 1198-modda; 2022-yil, № 3, 213-modda, № 6, 570, 577-moddalar, № 10, 984-modda; 2023-yil, № 1, 2-modda, № 10, 794-modda, № 12, 1003-modda; 2024-yil, № 8, 823-modda, № 10, 1075-modda; 2026-yil, № 4, 365-modda) 21-moddasining <a href="https://lex.uz/uz/docs/-112170?ONDATE=18.09.1993 00#-121252">toʻrtinchi qismidagi</a> “Oʻzbekiston Respublikasining Prezidenti bilan kelishilgan holda” degan soʻzlar “Oʻzbekiston Respublikasining Prezidenti tomonidan belgilanadigan tartibda” degan soʻzlar bilan almashtirilsin.</div></div><div class="ACT_TEXT"><div name="-8407783" id="-8407783">2. Oʻzbekiston Respublikasining 1997-yil 29-avgustda qabul qilingan “Davlat soliq xizmati toʻgʻrisida”gi 474-I-sonli Qonuni (Oʻzbekiston Respublikasi Oliy Majlisining Axborotnomasi, 1997-yil, № 9, 232-modda; 1998-yil, № 5-6, 102-modda; 1999-yil, № 9, 229-modda; 2000-yil, № 7-8, 217-modda; 2001-yil, № 5, 89-modda, № 9-10, 182-modda; 2003-yil, № 1, 8-modda, № 5, 67-modda; 2004-yil, № 9, 171-modda; 2005-yil, № 1, 18-modda; Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2005-yil, № 5, 152-modda, № 9, 312-modda, № 12, 415-modda; 2006-yil, № 10, 536-modda; 2007-yil, № 12, 608-modda; 2008-yil, № 12, 640-modda; 2009-yil, № 12, 474-modda; 2010-yil, № 9, 336-modda; 2012-yil, № 4, 105-modda; 2014-yil, № 9, 244-modda; 2015-yil, № 12, 452-modda; 2016-yil, № 12, 385-modda; 2017-yil, № 6, 300-modda, № 12, 773-modda; 2018-yil, № 1, 1, 4-moddalar; 2019-yil, № 1, 1, 5-moddalar, № 2, 47-modda, № 3, 166-modda, № 5, 267-modda; 2021-yil, 4-songa ilova; 2022-yil, № 3, 215-modda; 2026-yil, № 6, 625-modda) 10-moddasining <a href="https://lex.uz/uz/docs/-40158?ONDATE=18.12.2004 00#-407696">ikkinchi qismidagi</a> “Oʻzbekiston Respublikasi Prezidenti tomonidan” degan soʻzlar “Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadigan tartibda lavozimga” degan soʻzlar bilan almashtirilsin.</div></div><div class="ACT_TEXT"><div name="-8407784" id="-8407784">3. Oʻzbekiston Respublikasining 2012-yil 25-dekabrda qabul qilingan “Tezkor-qidiruv faoliyati toʻgʻrisida”gi OʻRQ-344-sonli Qonuni (Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2012-yil, № 12, 335-modda; 2016-yil, № 4, 125-modda; 2017-yil, № 9, 506-modda, № 10, 605-modda; 2019-yil, № 1, 5-modda, № 2, 47-modda, № 9, 589-modda, № 12, 891-modda; 2020-yil, № 12, 689-modda; 2021-yil, 4-songa ilova, № 6, 524-modda; 2024-yil, № 3, 244-modda) 17-moddasining <a href="https://lex.uz/uz/docs/-2107763?ONDATE=26.12.2013 00#-2107886">ikkinchi qismi </a>“sudyalar” degan soʻzdan keyin “Oʻzbekiston Respublikasi Prezidenti Administratsiyasining xodimlari” degan soʻzlar bilan toʻldirilsin.</div></div><div class="ACT_TEXT"><div name="-8407785" id="-8407785">4. Oʻzbekiston Respublikasining 2016-yil 16-sentabrda qabul qilingan “Ichki ishlar organlari toʻgʻrisida”gi OʻRQ-407-sonli Qonuni (Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2016-yil, № 9, 272-modda; 2017-yil, № 6, 300-modda, № 9, 510-modda; 2019-yil, № 2, 47-modda, № 5, 267-modda, № 9, 588, 591-moddalar, № 10, 674-modda, № 12, 891-modda; 2021-yil, 4-songa ilova; 2022-yil, № 3, 216-modda, № 5, 466-modda, № 6, 570-modda, № 10, 984-modda; 2023-yil, № 7, 537-modda; 2024-yil, № 3, 244-modda, № 9, 958, 964-moddalar, № 11, 1291-modda; 2025-yil, № 12, 1329-modda; 2026-yil, № 1, 2-modda, № 4, 355-modda, № 5, 499-modda) 14-moddasining <a href="https://lex.uz/uz/docs/-3027843?ONDATE=18.03.2017 00#-3027937">ikkinchi qismidagi</a> “Oʻzbekiston Respublikasi Prezidenti tomonidan” degan soʻzlar “Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadigan tartibda” degan soʻzlar bilan almashtirilsin.</div></div><div class="ACT_TEXT"><div name="-8407786" id="-8407786">5. Oʻzbekiston Respublikasining 2021-yil 20-aprelda qabul qilingan “Normativ-huquqiy hujjatlar toʻgʻrisida”gi OʻRQ-682-sonli <a href="https://lex.uz/uz/docs/-5378966">Qonuniga </a>(Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2021-yil, № 4, 288-modda; 2022-yil, № 3, 213-modda, № 8, 788-modda, № 10, 983-modda; 2023-yil, № 8, 629-modda, № 11, 923-modda; 2024-yil, № 2, 109-modda, № 9, 955-modda, № 10, 1075, 1076-moddalar; 2025-yil, № 4, 516-modda; 2026-yil, № 3, 256-modda) quyidagi qoʻshimcha va oʻzgartirishlar kiritilsin:</div></div><div class="ACT_TEXT"><div name="-8407787" id="-8407787">1) <a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5380860">6-modda</a>:</div></div><div class="ACT_TEXT"><div name="-8407788" id="-8407788">quyidagi mazmundagi oltinchi xatboshi bilan toʻldirilsin:</div></div><div class="ACT_TEXT"><div name="-8407789" id="-8407789">“Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Rahbarining farmoyishlari”;</div></div><div class="ACT_TEXT"><div name="-8407790" id="-8407790"><a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5380871">oltinchi</a>, <a href="https://lex.uz/uz/docs/-5378966?ONDATE=29.11.2023 01#-6687749">yettinchi </a>va <a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5380875">sakkizinchi xatboshilari </a>tegishincha yettinchi, sakkizinchi va toʻqqizinchi xatboshilar deb hisoblansin;</div></div><div class="ACT_TEXT"><div name="-8407791" id="-8407791">2) quyidagi mazmundagi 12<sup>1</sup>-modda bilan toʻldirilsin:</div></div><div class="CLAUSE_DEFAULT"><div name="-8407792" id="-8407792">“<b>12<sup>1</sup>-modda. Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Rahbarining farmoyishlari</b></div></div><div class="ACT_TEXT"><div name="-8407793" id="-8407793">Oʻzbekiston Respublikasi Prezidenti Administratsiyasining Rahbari Oʻzbekiston Respublikasi Konstitutsiyasi va qonunlari, Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari, farmoyishlari va topshiriqlari asosida hamda ularning ijrosini, Administratsiyaning faoliyatini samarali tashkil etish uchun Oʻzbekiston Respublikasining butun hududidagi barcha davlat organlari, korxonalar, muassasalar, tashkilotlar, mansabdor shaxslar tomonidan bajarilishi majburiy boʻlgan farmoyishlar qabul qiladi”;</div></div><div class="ACT_TEXT"><div name="-8407794" id="-8407794">3) 16-moddaning <a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5380930">uchinchi qismi </a>“Oʻzbekiston Respublikasi Prezidentining farmonlari, qarorlari va farmoyishlari” degan soʻzlardan keyin “Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Rahbarining farmoyishlari” degan soʻzlar bilan toʻldirilsin;</div></div><div class="ACT_TEXT"><div name="-8407795" id="-8407795">4) <a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5381171">36-modda</a>:</div></div><div class="ACT_TEXT"><div name="-8407796" id="-8407796">quyidagi mazmundagi oltinchi xatboshi bilan toʻldirilsin:</div></div><div class="ACT_TEXT"><div name="-8407797" id="-8407797">“Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Rahbarining farmoyishlariga nisbatan — Oʻzbekiston Respublikasi Prezidenti Administratsiyasi Rahbari”;</div></div><div class="ACT_TEXT"><div name="-8407798" id="-8407798"><a href="https://lex.uz/uz/docs/-5378966?ONDATE=20.04.2021 00#-5381186">oltinchi — toʻqqizinchi xatboshilari </a>tegishincha yettinchi — oʻninchi xatboshilar deb hisoblansin.</div></div><div class="ACT_TEXT"><div name="-8407799" id="-8407799">6. Oʻzbekiston Respublikasining 2024-yil 25-oktabrda qabul qilingan “Oʻzbekiston Respublikasi Vazirlar Mahkamasi toʻgʻrisida”gi OʻRQ-982-sonli Qonunining (Oʻzbekiston Respublikasi Oliy Majlisi palatalarining Axborotnomasi, 2024-yil, № 10, 1081-modda; 2025-yil, № 12, 1327-modda; 2026-yil, № 4, 365-modda) <a href="https://lex.uz/uz/docs/-7172667?ONDATE=26.10.2024 00#-7173004">20-moddasiga </a>quyidagi oʻzgartirishlar va qoʻshimcha kiritilsin:</div></div><div class="ACT_TEXT"><div name="-8407800" id="-8407800"><a href="https://lex.uz/uz/docs/-7172667?ONDATE=26.10.2024 00#-7173011">yettinchi qism </a>quyidagi tahrirda bayon etilsin:</div></div><div class="ACT_TEXT"><div name="-8407801" id="-8407801">“Respublika ijro etuvchi hokimiyat organlarining rahbarlari Oʻzbekiston Respublikasi Prezidenti tomonidan lavozimga tayinlanadi va lavozimidan ozod etiladi”;</div></div><div class="ACT_TEXT"><div name="-8407802" id="-8407802">quyidagi mazmundagi sakkizinchi qism bilan toʻldirilsin:</div></div><div class="ACT_TEXT"><div name="-8407803" id="-8407803">“Respublika ijro etuvchi hokimiyat organlari rahbarlarining oʻrinbosarlari Oʻzbekiston Respublikasi Prezidenti tomonidan belgilanadigan tartibda lavozimga tayinlanadi va lavozimidan ozod etiladi”;</div></div><div class="ACT_TEXT"><div name="-8407804" id="-8407804"><a href="https://lex.uz/uz/docs/-7172667?ONDATE=26.10.2024 00#-7173012">sakkizinchi — oʻn uchinchi qismlar </a>tegishincha toʻqqizinchi — oʻn toʻrtinchi qismlar deb hisoblansin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407805" id="-8407805"><b>32-modda. Ushbu Konstitutsiyaviy Qonunning ijrosini, yetkazilishini, mohiyati va ahamiyati tushuntirilishini taʼminlash</b></div></div><div class="ACT_TEXT"><div name="-8407806" id="-8407806">Oʻzbekiston Respublikasi Adliya vazirligi va boshqa manfaatdor tashkilotlar ushbu Konstitutsiyaviy Qonunning ijrosini, ijrochilarga yetkazilishini hamda mohiyati va ahamiyati aholi oʻrtasida tushuntirilishini taʼminlasin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407807" id="-8407807"><b>33-modda. Qonunchilikni ushbu Konstitutsiyaviy Qonunga muvofiqlashtirish</b></div></div><div class="ACT_TEXT"><div name="-8407808" id="-8407808">Oʻzbekiston Respublikasi Vazirlar Mahkamasi:</div></div><div class="ACT_TEXT"><div name="-8407809" id="-8407809">hukumat qarorlarini ushbu Konstitutsiyaviy Qonunga muvofiqlashtirsin;</div></div><div class="ACT_TEXT"><div name="-8407810" id="-8407810">respublika ijro etuvchi hokimiyat organlari ushbu Konstitutsiyaviy Qonunga zid boʻlgan oʻz normativ-huquqiy hujjatlarini qayta koʻrib chiqishlari va bekor qilishlarini taʼminlasin.</div></div><div class="CLAUSE_DEFAULT"><div name="-8407811" id="-8407811"><b>34-modda. Ushbu Konstitutsiyaviy Qonunning kuchga kirishi</b></div></div><div class="ACT_TEXT"><div name="-8407812" id="-8407812">Ushbu Konstitutsiyaviy Qonun rasmiy eʼlon qilingan kundan eʼtiboran kuchga kiradi.</div></div><div class="SIGNATURE"><div name="-8407813" id="-8407813">Oʻzbekiston Respublikasining Prezidenti Sh. MIRZIYOYEV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-8407814" id="-8407814">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-8407815" id="-8407815">2026-yil 14-avgust,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-8407816" id="-8407816">OʻRQ-<span translate="no">1166</span>-son</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="-8408213" id="-8408213">(Qonunchilik maʼlumotlari milliy bazasi, 14.08.2026-y., 03/26/1166/0842-son)</div></div></div>
</div></body></html>