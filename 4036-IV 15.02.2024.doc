<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-6854065" id="-6854065">Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Kengashi<br />
Oʻzbekiston Respublikasi Oliy Majlisi Senati Kengashining</div></div><div class="ACT_FORM"><div name="-6854067" id="-6854067">Qoʻshma qarori</div></div><div class="ACT_TITLE"><div name="-6854068" id="-6854068">Qonun ijodkorligi faoliyati boʻyicha dasturni tasdiqlash toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-6854069" id="-6854069"></div></div><div class="ACT_TEXT"><div name="-6854075" id="-6854075">Qonun ijodkorligi jarayoni samaradorligini oshirish, milliy qonunchilikni yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasi </a>talablari asosida takomillashtirish, toʻgʻridan-toʻgʻri amal qiladigan qonunlarni qabul qilish amaliyotini yanada kengaytirish, “Oʻzbekiston — 2030” strategiyasida belgilangan vazifalarni amalga oshirish maqsadida Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasining Kengashi va Oʻzbekiston Respublikasi Oliy Majlisi Senatining Kengashi qaror qiladilar:</div></div><div class="ACT_TEXT"><div name="-6854081" id="-6854081">1. Qonun ijodkorligi faoliyati boʻyicha dastur <a href="https://lex.uz/docs/-6853994#-6854136">1-ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-6854082" id="-6854082">2. Quyidagilar Qonun ijodkorligi faoliyati boʻyicha dasturning asosiy vazifalari etib belgilansin:</div></div><div class="ACT_TEXT"><div name="-6854083" id="-6854083">qonunlarning ijtimoiy munosabatlarni tartibga solishdagi rolini oshirish, qonun loyihalarini tayyorlash va Oʻzbekiston Respublikasi Oliy Majlisining Qonunchilik palatasiga kiritishda yagona amaliyotni shakllantirish, toʻgʻridan-toʻgʻri amal qiladigan qonunlar ulushini oshirish hamda bunday qonunlarni qabul qilishning samarali mexanizmlarini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854085" id="-6854085">tartibga solish yukini va ortiqcha byurokratik toʻsiqlarni kamaytirish hisobidan huquqni qoʻllash amaliyotini soddalashtirish, barcha uchun qulay boʻlgan sodda va ixcham qonunchilik tizimini yaratish, aniq sohalardagi munosabatlarni tartibga soluvchi qonun hujjatlarini kodifikatsiyalash orqali kompleks huquqiy tartibga solish darajasini oshirish hamda huquqiy tartibga solishning barqarorligini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6854087" id="-6854087">qonun ijodkorligi jarayonida fuqarolik jamiyati institutlari, ilmiy hamjamiyat vakillari va siyosiy partiyalar ishtirokini yanada kuchaytirish, ular bilan maslahatlashuvlar oʻtkazish amaliyotini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854088" id="-6854088">qonun ijodkorligida jamoatchilik muhokamasi tizimini takomillashtirish, barcha muhim huquqiy hujjatlar bevosita aholi bilan muloqot asosida, jamoatchilik fikrini hisobga olgan holda qabul qilinishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6854089" id="-6854089">milliy qonunchilik texnikasini tanqidiy koʻrib chiqish, qonun ijodkorligi jarayonida “aqlli tartibga solish” modelini va uning zamonaviy elementlarini, shu jumladan tartibga solish taʼsirini baholash tizimini keng joriy etish hamda qonun loyihalarini ekspertizadan oʻtkazish tizimini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854090" id="-6854090">qonunni qabul qilish, uning kuchga kirishi va orqaga qaytish kuchi, uni oʻz kuchini yoʻqotgan deb topish bilan bogʻliq tartib-taomillarni takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854092" id="-6854092">qonun ijodkorligi jarayonini raqamli transformatsiya qilish, qonun ijodkorligining qonunlarni tayyorlash, muhokama qilish, qabul qilish, maʼqullash, imzolash va eʼlon qilish jarayonlariga zamonaviy axborot texnologiyalarini keng joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854094" id="-6854094">yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasini </a>toʻliq amalga oshirish, unda mustahkamlangan ustuvor prinsiplarni yangi Oʻzbekiston ulugʻvor gʻoyasiga hamohang tarzda roʻyobga chiqarish, fuqarolar oʻz hayotida <a href="https://lex.uz/docs/-6445145">Konstitutsiya </a>ruhini yaqqol his etishini taʼminlash, “Oʻzbekiston — 2030” strategiyasidan kelib chiqadigan yaqin va oʻrta istiqboldagi qonun ijodkorligi faoliyati koʻlamini belgilash.</div></div><div class="ACT_TEXT"><div name="-6854095" id="-6854095">3. Qonun ijodkorligi faoliyati boʻyicha dasturni 2024-yilda amalga oshirish boʻyicha chora-tadbirlar rejasi (bundan buyon matnda Chora-tadbirlar rejasi deb yuritiladi) <a href="https://lex.uz/docs/-6853994#-6854459">2-ilovaga</a> muvofiq tasdiqlansin.</div></div><div class="ACT_TEXT"><div name="-6854096" id="-6854096">4. Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi huzuridagi Parlament tadqiqotlari instituti:</div></div><div class="ACT_TEXT"><div name="-6854098" id="-6854098">Chora-tadbirlar rejasida nazarda tutilgan normativ-huquqiy hujjatlar loyihalarini tayyorlashda masʼul idoralar va tashkilotlarga ilmiy-uslubiy va axborot-tahliliy jihatdan koʻmaklashsin;</div></div><div class="ACT_TEXT"><div name="-6854100" id="-6854100">Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasining va Oʻzbekiston Respublikasi Oliy Majlisi Senatining devonlari bilan birgalikda 2024-yil yakuni boʻyicha Chora-tadbirlar rejasi ijrosini puxta tahlil qilgan holda, zaruratga koʻra, Qonun ijodkorligi faoliyati boʻyicha dasturni 2025-yilda amalga oshirish boʻyicha chora-tadbirlar rejasini ishlab chiqsin.</div></div><div class="ACT_TEXT"><div name="-6854102" id="-6854102">5. Qonun ijodkorligi faoliyati boʻyicha dasturda hamda Chora-tadbirlar rejasida nazarda tutilgan vazifalar va tadbirlar oʻz vaqtida hamda sifatli bajarilishi uchun Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Spikerining hamda Oʻzbekiston Respublikasi Oliy Majlisi Senati Raisining birinchi oʻrinbosarlari va oʻrinbosarlari, Oʻzbekiston Respublikasi Oliy Majlisi palatalarining qoʻmitalari (komissiyalari) raislari, devonlari rahbarlari masʼul ekanligi belgilab qoʻyilsin.</div></div><div class="ACT_TEXT"><div name="-6854104" id="-6854104">6. Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Devonining Nazorat-tahlil boʻlimi (J. Jumayev) hamda Oʻzbekiston Respublikasi Oliy Majlisi Senati devonining Nazorat-tahlil boshqarmasi (R. Ibragimxodjayev) Qonun ijodkorligi faoliyati boʻyicha dasturda hamda Chora-tadbirlar rejasida belgilangan vazifalarning ijrosi yuzasidan har oyda tegishincha Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasining Kengashiga va Oʻzbekiston Respublikasi Oliy Majlisi Senatining Kengashiga umumlashtirilgan maʼlumot kiritib borsin.</div></div><div class="ACT_TEXT"><div name="-6854105" id="-6854105">7. Qonun ijodkorligi faoliyati boʻyicha dasturda va Chora-tadbirlar rejasida nazarda tutilgan vazifalar va tadbirlarning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Spikerining hamda Oʻzbekiston Respublikasi Oliy Majlisi Senati Raisining oʻrinbosarlari zimmasiga yuklatilsin.</div></div><div class="ACT_TEXT"><div name="-6854107" id="-6854107">8. Ushbu Qoʻshma qaror qabul qilingan kundan eʼtiboran kuchga kiradi.</div></div><div class="SIGNATURE"><div name="-6854109" id="-6854109"><strong>Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasining Spikeri N. ISMOILOV</strong></div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6854110" id="-6854110">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6854111" id="-6854111">2024-yil 15-fevral,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-6854113" id="-6854113">4036-IV-son</div></div><div class="SIGNATURE"><div name="-6854115" id="-6854115"><strong>Oʻzbekiston Respublikasi Oliy Majlisi Senatining Raisi T. NARBAYEVA</strong></div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6854116" id="-6854116">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6854117" id="-6854117">2024-yil 15-fevral,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-6854122" id="-6854122">KQ-683-IV-son</div></div><div class="BY_DEFAULT"><div name="-6854130" id="-6854130"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-6854136" id="-6854136">Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Kengashining va Oʻzbekiston Respublikasi Oliy Majlisi Senati Kengashining 2024-yil 15-fevraldagi № 4036-IV/KQ-683-IV-son Qoʻshma <a href="https://lex.uz/docs/-6853994">qaroriga</a><br />
1-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-6854139" id="-6854139">Qonun ijodkorligi faoliyati boʻyicha</div></div><div class="ACT_FORM"><div name="-6854141" id="-6854141">DASTUR</div></div><div class="BY_DEFAULT"><div name="-6854143" id="-6854143"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854152" id="-6854152">I. Qonun ijodkorligi faoliyati boʻyicha dasturning maqsadi va vazifalari</div></div><div class="ACT_TEXT"><div name="-6854153" id="-6854153">Qonun ijodkorligi faoliyati boʻyicha dasturning maqsadi ijtimoiy munosabatlarni huquqiy tartibga solishning barqarorligini taʼminlash hamda Yangi Oʻzbekiston iqtisodiy-ijtimoiy rivojlanishining yaqin va oʻrta istiqboldagi qonunchilik asoslarini rivojlantirish hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-6854154" id="-6854154">Mazkur maqsadga erishish uchun quyidagilar Qonun ijodkorligi faoliyati boʻyicha dasturning asosiy vazifalari hisoblanadi:</div></div><div class="ACT_TEXT"><div name="-6854155" id="-6854155">1) qonunlarning ijtimoiy munosabatlarni tartibga solishdagi rolini oshirish, qonun loyihalarini tayyorlash va Oliy Majlis Qonunchilik palatasiga kiritishda yagona amaliyotni shakllantirish, toʻgʻridan-toʻgʻri amal qiluvchi qonunlarning ulushini oshirish hamda bunday qonunlarni qabul qilishning samarali mexanizmlarini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854199" id="-6854199">2) tartibga solish yukini va ortiqcha byurokratik toʻsiqlarni kamaytirish hisobiga huquqni qoʻllash amaliyotini soddalashtirish, barcha uchun qulay boʻlgan sodda va ixcham qonunchilik tizimini yaratish, aniq sohalardagi munosabatlarni tartibga soluvchi qonun hujjatlarini kodifikatsiyalash orqali kompleks huquqiy tartibga solish darajasini oshirish hamda huquqiy tartibga solishning barqarorligini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6854202" id="-6854202">3) qonun ijodkorligi jarayonida fuqarolik jamiyati institutlari, ilmiy hamjamiyat vakillari va siyosiy partiyalarning ishtirokini yanada kuchaytirish, ular bilan maslahatlashuvlar oʻtkazish amaliyotini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854203" id="-6854203">4) qonun ijodkorligida jamoatchilik muhokamasi tizimini takomillashtirish, barcha muhim huquqiy hujjatlar bevosita aholi bilan muloqot asosida jamoatchilik fikrini hisobga olgan holda qabul qilinishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6854204" id="-6854204">5) milliy qonunchilik texnikasini tanqidiy koʻrib chiqish, qonun ijodkorligi jarayonida “aqlli tartibga solish” modeli va uning zamonaviy elementlarini, shu jumladan, tartibga solish taʼsirini baholash tizimini keng joriy qilish;</div></div><div class="ACT_TEXT"><div name="-6854205" id="-6854205">6) qonunni qabul qilish, uning kuchga kirishi va orqaga qaytish kuchi, uni oʻz kuchini yoʻqotgan deb topish bilan bogʻliq tartib-taomillarni takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854207" id="-6854207">7) qonun ijodkorligi jarayonini raqamli transformatsiya qilish, qonun ijodkorligining qonunlarni tayyorlash, muhokama qilish, qabul qilish, maʼqullash, imzolash va eʼlon qilish jarayonlariga zamonaviy axborot texnologiyalarini keng joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854208" id="-6854208">8) yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasini </a>toʻliq amalga oshirish, unda mustahkamlangan ustuvor prinsiplarni yangi Oʻzbekiston ulugʻvor gʻoyasiga hamohang tarzda roʻyobga chiqarish, fuqarolar oʻz hayotida <a href="https://lex.uz/docs/-6445145">Konstitutsiya </a>ruhini yaqqol his etib turishini taʼminlash borasida qonunchilik bazasini mustahkamlash, “Oʻzbekiston — 2030” strategiyasidan kelib chiqadigan yaqin va oʻrta istiqboldagi qonun ijodkorligi faoliyati koʻlamini belgilash.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854164" id="-6854164">II. Qonun ijodkorligini rivojlantirish boʻyicha davlat siyosati</div></div><div class="ACT_TEXT"><div name="-6854168" id="-6854168">Qonun ijodkorligi<strong> </strong>Oliy Majlis palatalari faoliyatining asosiy yoʻnalishlaridan biri hisoblanadi.</div></div><div class="ACT_TEXT"><div name="-6854169" id="-6854169">Shuning uchun Oliy Majlisning qonun ijodkorligi borasidagi faoliyati sifatini tubdan oshirish davlat siyosatining ustuvor yoʻnalishlaridan biriga aylandi.</div></div><div class="ACT_TEXT"><div name="-6854170" id="-6854170">Soʻnggi yillarda demokratik islohotlarni chuqurlashtirish va mamlakatni modernizatsiya qilishda Oliy Majlisning rolini yanada kuchaytirish yoʻnalishida qabul qilinayotgan qonunlarning amalga oshirilayotgan ijtimoiy-siyosiy, ijtimoiy-iqtisodiy va sud-huquq islohotlari jarayoniga taʼsirini kuchaytirishga yoʻnaltirilgan holda qonun ijodkorligi faoliyati sifati tubdan takomillashtirildi.</div></div><div class="ACT_TEXT"><div name="-6854171" id="-6854171">Qonunchilik tashabbusi huquqi subyektlarining qonun ijodkorligi jarayonidagi masʼuliyati kuchaytirildi. “Normativ-huquqiy hujjatlarning va ular loyihalarining korrupsiyaga qarshi ekspertizasi toʻgʻrisida”gi <a href="https://lex.uz/docs/-6561894">Qonun</a>, yangi tahrirdagi “Normativ-huquqiy hujjatlar toʻgʻrisida”gi <a href="https://lex.uz/docs/-5378966">Qonun</a> qabul qilindi. Qonunchilik tashabbusi huquqini amalga oshirishning aniq tartibi belgilandi. Qonun loyihasi birinchi oʻqishda qabul qilinayotganda, qoida tariqasida, qonunchilik tashabbusi huquqi subyekti yoki uning vakili maʼruza bilan chiqishi va himoya qilishi belgilandi.</div></div><div class="ACT_TEXT"><div name="-6854172" id="-6854172">Ushbu amaliyotning joriy etilishi tashabbuskor idoraning qonun loyihalarini tayyorlash boʻyicha masʼuliyatini yanada oshirishga, loyihalar sifatini yaxshilashga, subyektlarning qonun ijodkorligi jarayonidagi faolligini yanada kuchaytirishga xizmat qilmoqda.</div></div><div class="ACT_TEXT"><div name="-6854174" id="-6854174">Qonun hujjatlariga oʻzgartish va qoʻshimchalar kiritishni nazarda tutuvchi qonun loyihalarining shakli hamda ularni rasmiylashtirish tartibi takomillashtirilib, ularda mazkur oʻzgartish va qoʻshimchalarning mazmun-mohiyatini aholiga sodda tilda tushuntirishga qaratilgan muqaddimaning kiritilishi belgilandi.</div></div><div class="ACT_TEXT"><div name="-6854175" id="-6854175">Oʻzbekiston Respublikasi Prezidentining 2018-yil 8-avgustdagi “Norma ijodkorligi faoliyatini takomillashtirish konsepsiyasini tasdiqlash toʻgʻrisida”gi PF-5505-sonli <a href="https://lex.uz/docs/-3858817">Farmoni</a> norma ijodkorligi faoliyatiga zamonaviy yondashuv va yangicha mazmun-mohiyat olib kirdi. Normativ-huquqiy hujjatlarni ishlab chiqish va toʻgʻridan-toʻgʻri amal qiluvchi qonunlarni qabul qilishning yangi, demokratik shakllarini joriy etish, qonun loyihalarini keng jamoatchilik vakillari va ekspertlar doirasida muhokamalardan oʻtkazish, shuningdek, qonun loyihalarining xalqaro shartnoma va reytinglarga mosligini oʻrganishga ustuvor ahamiyat berildi. Natijada oxirgi 6 yil ichida “Qonun ustuvorligi” (Rule of Law) hamda “Butunjahon boshqaruv koʻrsatkichlari” (WGI) indekslarida “qonun ustuvorligi”, “tartibga solish sifati” koʻrsatkichlari boʻyicha Oʻzbekiston tegishlicha 5 va 24 pogʻonaga koʻtarildi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854178" id="-6854178">III. Qonun ijodkorligining hozirgi holati</div></div><div class="ACT_TEXT"><div name="-6854179" id="-6854179">Oʻtgan davr mobaynida qonun ijodkorligi sohasida quyidagi ishlar amalga oshirildi:</div></div><div class="ACT_TEXT"><div name="-6854182" id="-6854182">Birinchidan, qonun loyihalarining xalqaro shartnomalarga, Oʻzbekistonning xalqaro reytinglardagi oʻrnini yaxshilash boʻyicha tavsiyalarga mosligini oʻrganish amaliyoti yoʻlga qoʻyildi.</div></div><div class="ACT_TEXT"><div name="-6854184" id="-6854184">Bu esa, davlatimizning xalqaro maydondagi majburiyatlarining toʻlaqonli bajarilishiga erishish, yurtimizning investitsiyaviy jozibadorligini oshirish, pirovardida Oʻzbekistonning xalqaro maydondagi nufuzini yanada yaxshilashga xizmat qilmoqda.</div></div><div class="ACT_TEXT"><div name="-6854211" id="-6854211">Ikkinchidan, Oliy Majlis Qonunchilik palatasining oʻtgan davrdagi qonun ijodkorligi faoliyatida qonun loyihalarini koʻproq qoʻmitalarda, fraksiyalarda muhokama qilishga ustuvor ahamiyat qaratildi. Jumladan, qonun loyihalari muhokamasiga bagʻishlangan fraksiyalararo debatlarni tashkil etish amaliyoti yoʻlga qoʻyildi.</div></div><div class="ACT_TEXT"><div name="-6854212" id="-6854212">Siyosiy xilma-xillik, koʻppartiyaviylik, masalalarni erkin muhokama qilish va jamoa boʻlib hal etish tamoyillariga asosan har bir qonun loyihasi yoki masala siyosiy partiyalar fraksiyalarining yigʻilishlarida dastlabki tarzda koʻrib chiqilgandan keyin Qonunchilik palatasi majlisining kun tartibiga kiritish prinsipiga qatʼiy amal qilindi.</div></div><div class="ACT_TEXT"><div name="-6854213" id="-6854213">Uchinchidan, “Xalq — qonunlarning tom maʼnoda yagona manbai va muallifi hisoblanadi” hamda “Barcha muhim qarorlar bevosita xalq bilan muloqot asosida jamoatchilikning fikrini hisobga olgan holda qabul qilinadi” degan tamoyillar asosida qonun ijodkorligi faoliyatiga jamoatchilikni keng jalb qilish, qonun loyihalarini fuqarolarning fikr-mulohazalari va takliflarini oʻrgangan holda tayyorlash, koʻrib chiqilayotgan loyihalar yuzasidan aholi oʻrtasida ochiq muhokamalar oʻtkazishga ustuvor ahamiyat qaratilmoqda. Xususan, “regulation.gov.uz” portalining yangi talqini joriy etilib, jamoatchilik muhokamasi yanada qulay va sodda boʻlishi taʼminlandi.</div></div><div class="ACT_TEXT"><div name="-6854216" id="-6854216">Qonun ijodkorligi faoliyati huquqiy, tashkiliy va amaliy jihatdan takomillashib borishi bu borada sifat koʻrsatkichlarini yanada yaxshilashga, xalqimiz hayoti va farovonligini taʼminlashga xizmat qiladigan qonun hujjatlari qabul qilinishiga erishishda muhim omil boʻlmoqda.</div></div><div class="ACT_TEXT"><div name="-6854218" id="-6854218">Toʻrtinchidan, parlament faoliyatida toʻgʻridan-toʻgʻri amal qiladigan, yaʼni ijro etilishi uchun qonunosti hujjati ishlab chiqilishi talab etilmaydigan qonunlarni qabul qilishga eʼtibor kuchaytirildi. Qonun loyihalarini mahalliy Kengashlar bilan keng muhokama qilinishi, ularning fikr-mulohazalari va takliflari bevosita joyiga chiqib oʻrganilishi bu yoʻnalishdagi faoliyat samaradorligini oshirdi. Qonun ijodkorligi jarayoniga bunday yangiliklarning tatbiq etilishi natijasida qonun hujjatlarining amaliy samaradorligi va hayotiyligi oshmoqda.</div></div><div class="ACT_TEXT"><div name="-6854219" id="-6854219">Shu bilan birga “Oʻzbekiston — 2030” strategiyasida norma ijodkorligi faoliyatining islohotlar bilan uygʻunligini taʼminlash va davlat huquqiy siyosatining institutsional asoslarini rivojlantirish alohida maqsad sifatida belgilangan.</div></div><div class="ACT_TEXT"><div name="-6854222" id="-6854222">Ushbu maqsadga erishish uchun 2030-yilgacha erishiladigan maqsadlarning bir qator samaradorlik koʻrsatkichlari belgilab berilgan. Xususan, 2030-yilga qadar toʻgʻridan-toʻgʻri amal qiladigan qonunlarni qabul qilish amaliyotini kengaytirish, ularning monitoringi va tartibga solish taʼsirini baholash hajmini oshirish, barcha uchun qulay, sodda va ixcham qonunchilik tizimini yaratish shular jumlasidan.</div></div><div class="ACT_TEXT"><div name="-6854223" id="-6854223">Ushbu maqsadga va samaradorlik koʻrsatkichlariga erishish uchun qonun ijodkorligi va parlament nazoratini amalga oshirishning amaldagi mexanizmlari samaradorligini oshirish, qonun ijodkorligi va parlament nazoratini amalga oshirishning amaldagi mexanizmlarini samaradorlik nuqtai nazaridan qayta koʻrib chiqish, mazkur jarayonlarda fuqarolarning ishtirokini taʼminlash orqali jamoatchilikning davlat boshqaruvidagi tashabbuskorligini oshirish boʻyicha chora-tadbirlarni belgilash lozim.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854224" id="-6854224">IV. Qonun ijodkorligi sohasida yoʻl qoʻyilayotgan kamchiliklar</div></div><div class="ACT_TEXT"><div name="-6854226" id="-6854226">“Oʻzbekiston — 2030” strategiyasida belgilangan keng koʻlamli islohotlarning muvaffaqiyatli amalga oshirilishi, koʻp jihatdan, qonun ijodkorligi jarayoni sifatiga bogʻliq.</div></div><div class="ACT_TEXT"><div name="-6854227" id="-6854227">Shu sababli qonun ijodkorligi jarayonini tubdan takomillashtirish va yangi sifat darajasiga koʻtarish, mazkur yoʻnalishda mavjud boʻlgan qator kamchiliklarni bartaraf etish davlat siyosatining ustuvor vazifalaridan biri boʻlmoqda.</div></div><div class="ACT_TEXT"><div name="-6854228" id="-6854228">Birinchidan, turli sohalardagi ijtimoiy munosabatlarni tarqoq holda tartibga solish kabi salbiy amaliyotning davom etishi huquqiy kolliziyalar, huquqni qoʻllashda turlicha talqin qilish va murakkabliklar yuzaga kelishiga sabab boʻlmoqda.</div></div><div class="ACT_TEXT"><div name="-6854229" id="-6854229">Ikkinchidan, bugungi kun voqeligi tizimli muammolarga tezkorlik bilan munosabat bildirishni talab qiladi. Oʻz navbatida buning salbiy oqibati sifatida norma ijodkorligi jarayonida qonun hujjatlari loyihalarining tartibga solish taʼsiri, shu jumladan, tadbirkorlik subyektlari va fuqarolarga tartibga solish yuki har doim ham baholanmayapti.</div></div><div class="ACT_TEXT"><div name="-6854230" id="-6854230">Uchinchidan, umumiy tusga ega, amalga oshirishning aniq mexanizmi yoʻq qonunlarning koʻpligi davlat va jamiyat rivojiga salbiy taʼsir koʻrsatmoqda, ijtimoiy munosabatlarni asosan qonunosti hujjatlari bilan tartibga solishga sabab boʻlmoqda. Qolaversa, qonun loyihalaridagi havolaki normalar ularni qoʻllovchi mansabdor shaxslar tomonidan turli suiisteʼmolchiliklarga, normalarni oʻzi bilgancha talqin qilishi uchun sharoit yaratishi mumkin.</div></div><div class="ACT_TEXT"><div name="-6854231" id="-6854231">Toʻrtinchidan, qonun loyihalari boʻyicha oʻtkazilishi shart boʻlgan korrupsiyaga qarshi ekspertizaning samaradorligi sezilmayapti, qonun hujjatlarida nazarda tutilgan iqtisodiy, moliyaviy, ilmiy, lingvistik, ekologik, gender-huquqiy, barqaror rivojlanish sohasidagi milliy maqsad va vazifalarga mosligi yuzasidan ekspertizadan oʻtkazish amaliyotida ham kamchiliklar mavjud. Qonunchilik tashabbusi huquqi subyektlari tomonidan qonun loyihalarining sifatiga yetarli darajada eʼtibor qaratilmasdan Qonunchilik palatasiga kiritilishi ularni parlamentda qoʻshimcha ishlash davomida koʻp muddat va kuch sarf qilinishiga sabab boʻlmoqda.</div></div><div class="ACT_TEXT"><div name="-6854233" id="-6854233">Beshinchidan, qonun ijodkorligi jarayonini raqamlashtirish ishlari oxirigacha yetkazilmagan hamda qogʻoz koʻrinishidagi hujjat aylanishiga toʻliq barham berilmagan. Qonun loyihalarini Qonunchilik palatasiga toʻliq elektron shaklda kiritish amaliyoti yoʻlga qoʻyilmagan hamda ular Oʻzbekiston Respublikasi Prezidentiga yuborilishiga qadar boʻlgan barcha bosqichlarda hujjatlar aylanishida hamon qogʻozdan foydalanilmoqda.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854235" id="-6854235">V. Qonun ijodkorligi faoliyati boʻyicha dasturning asosiy yoʻnalishlari</div></div><div class="ACT_TEXT"><div name="-6854238" id="-6854238">“Oʻzbekiston — 2030” strategiyasida belgilab berilgan maqsad va vazifalardan kelib chiqib, Qonun ijodkorligi faoliyati boʻyicha dasturda quyidagi asosiy yoʻnalishlar belgilanmoqda.</div></div><div class="ACT_TEXT"><div name="-6854239" id="-6854239">Birinchi ustuvor yoʻnalish — qonunlarning ijtimoiy munosabatlarni tartibga solishdagi rolini oshirish, qonun loyihalarini tayyorlash va Oliy Majlis Qonunchilik palatasiga kiritishda yagona amaliyotni shakllantirish.</div></div><div class="ACT_TEXT"><div name="-6854241" id="-6854241">Ushbu yoʻnalishda amalga oshiriladigan tadbirlar:</div></div><div class="ACT_TEXT"><div name="-6854242" id="-6854242">toʻgʻridan-toʻgʻri amal qiladigan qonun loyihasining mazmuni, tuzilishi va amal qilish mexanizmiga qoʻyiladigan asosiy talablarni shakllantirish, qonun loyihasida undagi havolaki normalarni amalga oshirishning aniq muddatlari va masʼul ijrochilarini belgilash amaliyotini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854243" id="-6854243">toʻgʻridan-toʻgʻri amal qiluvchi qonunlarning ulushini izchil oshirib borish hisobiga qonunchilik hujjatlarini maqbullashtirish, shu jumladan, idoraviy normativ-huquqiy hujjatlar sonini muntazam qisqartirish amaliyotini davom ettirish;</div></div><div class="ACT_TEXT"><div name="-6854244" id="-6854244">qonunlarning ijtimoiy munosabatlarni tartibga solishdagi rolini oshirish maqsadida tegishli sohani tartibga soluvchi qonun loyihasini tayyorlashda ushbu sohadagi qonunosti hujjatlari bilan tartibga solingan munosabatlarni qonun darajasiga koʻtarish imkoniyatini muhokama qilish shartligini belgilash;</div></div><div class="ACT_TEXT"><div name="-6854245" id="-6854245">qonun loyihalarini tayyorlashda Oʻzbekiston Respublikasi xalqaro shartnomalarida belgilangan, rivojlangan demokratik mamlakatlarda va xalqaro huquqda umumeʼtirof etilgan standart va mezonlarni aks ettirish;</div></div><div class="ACT_TEXT"><div name="-6854247" id="-6854247">Oʻzbekiston Respublikasining saylov huquqiga ega boʻlgan yuz ming nafardan kam boʻlmagan fuqarolari, Oliy Majlis Senati, Oliy Majlisning Inson huquqlari boʻyicha vakili (ombudsman), Markaziy saylov komissiyasining qonunchilik takliflarini Qonunchilik palatasiga kiritish va koʻrib chiqish tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854248" id="-6854248">Oliy Majlis Qonunchilik palatasiga kiritilayotgan qonun loyihalarining moliyaviy-iqtisodiy asoslarini puxta tayyorlash, bunda qonun loyihasining qabul qilinishi natijasida Davlat budjetidan kelgusida sarf qilinadigan barcha xarajatlarni inobatga olish;</div></div><div class="ACT_TEXT"><div name="-6854249" id="-6854249">qonun loyihasiga tushuntirish xatida uning maqsadi va kutilayotgan natijani aniq shakllantirish, kelgusida ushbu maqsad va natijaga erishilganligini baholash tizimini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854250" id="-6854250">qonun loyihasini ishlab chiqish boʻyicha ishchi guruhlar tarkibiga ushbu loyiha manfaatlariga daxl qilishi mumkin boʻlgan soha, tashkilotlar mutaxassislarini, olimlar va jamoatchilik vakillarini ham taklif qilish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854253" id="-6854253">qonunchilik tashabbuslarini ilgari surishning (qonunchilik lobbisi) aniq mezonlari va shartlarini, ularni keng jamoatchilik muhokamasidan oʻtkazish, kelishish hamda xalq manfaatlarini, umumdavlat rivojlanish strategiyasini hisobga olgan holda qabul qilish boʻyicha rivojlangan xorijiy davlatlar tajribasini oʻrganish;</div></div><div class="ACT_TEXT"><div name="-6854254" id="-6854254">qonunlarni havolaki normalarning amalga oshirilganligi nuqtai nazaridan xatlovdan oʻtkazish va realizatsiya qilinmagan havolaki normalarni amalga oshirish choralarini koʻrish;</div></div><div class="ACT_TEXT"><div name="-6854255" id="-6854255">qonun ijodkorligi sohasidagi fundamental, amaliy va innovatsion tadqiqotlarni faollashtirish, shu jumladan, Parlament tadqiqotlari instituti hamda Davlat va huquq institutida yetakchi olim va ekspertlarni jalb etgan holda qonun ijodkorligining zamonaviy muammolari boʻyicha ilmiy tadqiqotlarni olib borish.</div></div><div class="ACT_TEXT"><div name="-6854257" id="-6854257">Ikkinchi ustuvor yoʻnalish — tartibga solish yukini va ortiqcha byurokratik toʻsiqlarni kamaytirish hisobiga huquqni qoʻllash amaliyotini soddalashtirish, barcha uchun qulay boʻlgan sodda va ixcham qonunchilik tizimini yaratish.</div></div><div class="ACT_TEXT"><div name="-6854259" id="-6854259">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854260" id="-6854260">maʼlum bir sohadagi ijtimoiy munosabatlarni tarqoq holda tartibga solish amaliyotiga xos boʻlgan huquqiy kolliziyalar, huquqni qoʻllashda turlicha talqin qilish va bitta huquqiy munosabatni turlicha tartibga solish kabi salbiy holatlarga barham berishga qaratilgan tizimlashtirish, shu jumladan, kodifikatsiyalash, tartibga solish gilotinasi jarayonlarini yanada jadallashtirish;</div></div><div class="ACT_TEXT"><div name="-6854261" id="-6854261">qonun hujjatlarini kodifikatsiyalash boʻyicha boshlangan, lekin yakunlanmagan ishlarni tanqidiy tahlil qilish, kodifikatsiyalashga toʻsqinlik qilayotgan omillarni aniqlash, ularni bartaraf etish choralarini koʻrish;</div></div><div class="ACT_TEXT"><div name="-6854263" id="-6854263">amaldagi qonun hujjatlarini xatlovdan oʻtkazib, eskirgan va oʻz ahamiyatini yoʻqotganlarini bekor qilish hamda turdosh munosabatlarni tartibga soluvchi, tarqoq qonun va qonunosti hujjatlarni yaxlit qonunga birlashtirish orqali kodifikatsiyalash maqsadida 2030-yilgacha moʻljallangan kodifikatsiyalash rejasini ishlab chiqish va amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-6854264" id="-6854264">Oliy Majlis Qonunchilik palatasi qoʻmitalari tomonidan vazirliklar oʻz yoʻnalishlarida qonunchilikdagi byurokratik toʻsiqlarni yanada qisqartirish yuzasidan amalga oshirgan ishlari boʻyicha hisobotlarini eshitib borish va natijalari boʻyicha takliflar kiritish.</div></div><div class="ACT_TEXT"><div name="-6854265" id="-6854265">Uchinchi asosiy yoʻnalish — qonun ijodkorligi jarayonida fuqarolik jamiyati institutlari, ilmiy hamjamiyat vakillari va siyosiy partiyalarning ishtirokini yanada kuchaytirish, ular bilan maslahatlashuvlar oʻtkazish amaliyotini takomillashtirish.</div></div><div class="ACT_TEXT"><div name="-6854266" id="-6854266">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854267" id="-6854267">qonun ijodkorligi jarayonida fuqarolik jamiyati institutlari bilan maslahatlashuvlar oʻtkazishning yangicha tartibini joriy etish, bunda har bir qoʻmitada tegishli soha boʻyicha qonunlarni koʻrib chiqishda qoʻmita bilan hamkorlik qiladigan nodavlat notijorat tashkilotlari roʻyxatini yuritish, qoʻmitaga kelib tushgan qonunlarni tegishli nodavlat notijorat tashkilotlariga ham koʻrib chiqish va taklif berish uchun yuborish, ularning qonun loyihasi boʻyicha fikrini qoʻmita, fraksiya va palata majlislarida muhokama etish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854268" id="-6854268">qonun loyihalarini ishlab chiqishning barcha bosqichida, shuningdek qonun loyihalarining qoʻmitalar va fraksiyalar tomonidan koʻrib chiqilishida ekspertlar va ilmiy hamjamiyat vakillari bilan maslahatlashish amaliyotini kengaytirish, qoʻmitalar huzuridagi ekspertlar guruhlari tarkibini kengaytirib, ularning ishini yanada jonlantirish;</div></div><div class="ACT_TEXT"><div name="-6854270" id="-6854270">qonun ijodkorligi jarayonida faol ishtirok etayotgan olimlar, mutaxassis va ekspertlarni ragʻbatlantirishning tashkiliy-huquqiy va moddiy tartibini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854273" id="-6854273">qonun ijodkorligi jarayoniga ilmiy va ekspert doiralar vakillari, oliy taʼlim tashkilotlarining ilmiy darajalar olish uchun talabgorlarining qonunchilik va huquqiy tartibga solishni takomillashtirish boʻyicha takliflarini oʻz ichiga olgan ilmiy-tahliliy faoliyati natijalaridan foydalanish uchun aloqa tizimini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854274" id="-6854274">qonun loyihalari boʻyicha jamoatchilik muhokamasini tashkil etishda siyosiy partiyalarning rolini oshirish, siyosiy partiyalar, shu jumladan, ularning quyi tuzilmalaridan qonun loyihalari boʻyicha taklif va xulosalar olish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854275" id="-6854275">siyosiy partiyalar tomonidan, ayniqsa, ularning elektorati manfaatlariga taalluqli qonun loyihalari boʻyicha jamoatchilik eshituvlarini tashkil etish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854276" id="-6854276">qonun ijodkorligi sohasida va ushbu yoʻnalishda tadqiqotlar olib borishda ijtimoiy sheriklikni rivojlantirish.</div></div><div class="ACT_TEXT"><div name="-6854278" id="-6854278">Toʻrtinchi asosiy yoʻnalish — qonun ijodkorligida jamoatchilik muhokamasi tizimini takomillashtirish, barcha muhim huquqiy hujjatlar bevosita aholi bilan muloqot asosida, jamoatchilik fikrini hisobga olgan holda qabul qilinishini taʼminlash.</div></div><div class="ACT_TEXT"><div name="-6854279" id="-6854279">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854280" id="-6854280">qabul qilinayotgan qonunlarning mazmun-mohiyatini aholiga, tadbirkorlik subyektlariga, huquqni qoʻllovchilarga tushuntirish uchun qoʻllaniladigan shakl va usullarni yanada takomillashtirish, shu jumladan, yangi qabul qilingan qonunlar mazmun-mohiyatini huquqni qoʻllovchilarga tushuntirish uchun seminar-treninglar oʻtkazish, uning yakuni boʻyicha ularning bilimiga baho berish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854281" id="-6854281">jamoatchilik muhokamasiga chiqarilayotgan qonun loyihalari, ayniqsa, amaldagi qonunlarga oʻzgartirish va qoʻshimchalar kiritishni nazarda tutuvchi loyihalar boʻyicha ularning mazmun-mohiyatini aholi uchun sodda va tushunarli tilda izohlab berish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854282" id="-6854282">ishlab chiqaruvchi tomonidan muhokama ishtirokchilarining takliflarini majburiy tarzda koʻrib chiqish toʻgʻrisidagi talabga rioya etilishi ustidan nazoratning taʼsirchan mexanizmlarini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854283" id="-6854283">jamoatchilik muhokamasiga chiqarilayotgan qonun loyihalari boʻyicha masʼul vazirlik va idoralar vakillarining qonun loyihasi yuzasidan bildirilayotgan taklif va eʼtirozlariga munosabat bildirish, aholining koʻp eʼtirozlariga sabab boʻlgan qonun loyihalari boʻyicha OAVda, ijtimoiy tarmoqlardagi rasmiy sahifalarda alohida chiqishlar tashkil etish;</div></div><div class="ACT_TEXT"><div name="-6854284" id="-6854284">qonun ijodkorligi jarayonida jamoatchilik bilan oʻzaro hamkorlik qilishning zamonaviy shakllari va mexanizmlarini joriy etish, jamoatchilik muhokamasi ishtirokchilari tomonidan munosabat bildirish tartib-taomillarini yanada soddalashtirish, fuqarolar uchun qulaylik yaratish orqali elektron maydonchaga tashrif buyuruvchilar sonini oshirish;</div></div><div class="ACT_TEXT"><div name="-6854285" id="-6854285">yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasini </a>ishlab chiqish va qabul qilish tajribasi asosida qonun loyihalarini ishlab chiqishdan oldin ularning tayyorlanishi boʻyicha axborotni jamoatchilik muhokamasi portaliga joylashtirish va loyihani jamoatchilikning taklif va tavsiyalarini asosida ishlab chiqish tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854286" id="-6854286">qonun ijodkorligi jarayoniga fuqarolarning bevosita qatnashishini taʼminlash maqsadida Oliy Majlis palatalari majlislarida aholining ishtirok etishi boʻyicha yangicha mexanizmlarni joriy etish.</div></div><div class="ACT_TEXT"><div name="-6854288" id="-6854288">Beshinchi asosiy yoʻnalish — qonun ijodkorligiga “aqlli tartibga solish” modeli elementlari, shu jumladan, tartibga solish taʼsirini baholash tizimini keng joriy qilish hamda qonun loyihalarini ekspertizadan oʻtkazish tizimini takomillashtirish.</div></div><div class="ACT_TEXT"><div name="-6854289" id="-6854289">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854290" id="-6854290">tadbirkorlik subyektlarining huquq va qonuniy manfaatlariga bevosita daxl qiluvchi qonunlarni ishlab chiqishda soha vakillarining takliflarini koʻrib chiqish va ular bilan muhokamalar oʻtkazish amaliyotini keng tatbiq qilish;</div></div><div class="ACT_TEXT"><div name="-6854292" id="-6854292">Oliy Majlis Qonunchilik palatasiga yaxlit qonun loyihalarini kiritishda loyiha boʻyicha tartibga solish taʼsirini baholash xulosasi majburiy tarzda ilova qilinishi talabini belgilash;</div></div><div class="ACT_TEXT"><div name="-6854293" id="-6854293">qonun kuchga kirib, besh yildan soʻng masʼul davlat organi va Oliy Majlis palatalarining masʼul qoʻmitalari tomonidan qonunning samaradorligini, oʻz maqsadi va kutilgan natijalariga erishilganligini aniqlash maqsadida uning taʼsirini baholash tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854295" id="-6854295">huquq tizimi raqobatbardoshligini oshirish, normativ-huquqiy hujjatlarning “korrupsiyadan xoli qonunchilik” tamoyili asosida ishlab chiqilishini taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6854296" id="-6854296">tartibga solish taʼsirini baholashda vazirlik va idoralarga yuklanayotgan topshiriqlar ularning funksional vazifalariga muvofiqligiga ham baho berish, tashkilotlarga ularning funksional vazifalariga aloqasi boʻlmagan topshiriqlar yuklatilishiga yoʻl qoʻymaslik;</div></div><div class="ACT_TEXT"><div name="-6854298" id="-6854298">qonun loyihalarini jamoatchilik ekspertizasidan oʻtkazish amaliyotini kengaytirish va ularni barqaror rivojlanish sohasidagi milliy maqsad va vazifalariga mosligi yuzasidan ekspertizadan oʻtkazish tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854305" id="-6854305">qonun loyihalarini ilmiy, lingvistik, gender-huquqiy ekspertizadan oʻtkazish amaliyotini yanada rivojlantirish, shu jumladan, ushbu yoʻnalishda maktablar shakllantirish uchun zarur shart-sharoit yaratish.</div></div><div class="ACT_TEXT"><div name="-6854306" id="-6854306">Oltinchi asosiy yoʻnalish — qonun qabul qilish, uning kuchga kirishi va orqaga qaytish kuchi, uni oʻz kuchini yoʻqotgan deb topish bilan bogʻliq tartib-taomillarni takomillashtirish.</div></div><div class="ACT_TEXT"><div name="-6854307" id="-6854307">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854308" id="-6854308">Oliy Majlis Qonunchilik palatasi qoʻmitalari tomonidan qonun loyihalarini koʻrib chiqish amaliyotini takomillashtirish, shu jumladan, qoʻmitada qonun loyihasi boʻyicha muhokamalarni tashkil etish va qarorlarni ovoz berish orqali qabul qilishning aniq tartibini belgilash, shu jumladan, qonun loyihasini ikkinchi oʻqishga tayyorlash jarayonida uni moddama-modda koʻrib chiqish tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854324" id="-6854324">qonun loyihalarini ikkinchi oʻqishda koʻrib chiqish davomida qonunchilik tashabbusi huquqi subyekti tomonidan uni qaytarib olish imkoniyatini kiritish;</div></div><div class="ACT_TEXT"><div name="-6854327" id="-6854327">ilgʻor xorijiy tajribadan kelib chiqib, fuqarolar, tadbirkorlik subyektlari, fuqarolik jamiyati institutlariga qoʻshimcha majburiyat yuklashni nazarda tutuvchi qonunchilik normalarini kalendar yilning aniq sanasini belgilash orqali kuchga kirishini taʼminlash orqali tadbirkorlik subyektlariga oʻz shart-sharoitlarini shunga qarab moslash imkoniyatini yaratish;</div></div><div class="ACT_TEXT"><div name="-6854330" id="-6854330">qabul qilingan qonunlar ijrosini monitoring qilish amaliyotini takomillashtirish va samaradorligini oshirish choralarini koʻrish;</div></div><div class="ACT_TEXT"><div name="-6854341" id="-6854341">qonun loyihasida fuqarolar, tadbirkorlik subyektlarining huquq va manfaatlari bilan bogʻliq cheklovchi normalar boʻlganda ularning orqaga qaytish kuchini aniq belgilash tartibini joriy etish;</div></div><div class="ACT_TEXT"><div name="-6854343" id="-6854343">oʻzgartirish va qoʻshimchalar kiritishni nazarda tutuvchi qonunlar qabul qilingandan soʻng qonun loyihasiga taqqoslash jadvallarini Oliy Majlis palatalarining rasmiy veb-saytlarida joylashtirish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854346" id="-6854346">yuqori turuvchi normativ-huquqiy hujjat oʻz kuchini yoʻqotgan deb topilganda uning asosida qabul qilingan quyi turuvchi normativ-huquqiy hujjatlarni xatlovdan oʻtkazish va ularni ham yuqori turuvchi normativ-huquqiy hujjat bekor qilingan sanadan boshlab oʻz kuchini yoʻqotgan deb topish tartibini yoʻlga qoʻyish.</div></div><div class="ACT_TEXT"><div name="-6854347" id="-6854347">Ettinchi asosiy yoʻnalish — qonun ijodkorligi jarayonini raqamli transformatsiya qilish.</div></div><div class="ACT_TEXT"><div name="-6854348" id="-6854348">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854349" id="-6854349">qonun ijodkorligining barcha bosqichlarini avtomatlashtirish, qonun loyihasining harakatini onlayn kuzatib borish, shuningdek, Oliy Majlis palatalari va ularning organlari qarorlarini elektron tarzda rasmiylashtirishga oʻtish;</div></div><div class="ACT_TEXT"><div name="-6854351" id="-6854351">qonun loyihalarini Qonunchilik palatasiga toʻliq elektron shaklda kiritish, ularning Oʻzbekiston Respublikasi Prezidentiga yuborilishiga qadar boʻlgan bosqichlarda hujjatlar aylanishida qogʻoz ishtirokiga toʻliq barham berish;</div></div><div class="ACT_TEXT"><div name="-6854354" id="-6854354">qonun loyihalarini tayyorlash jarayoniga oid muayyan texnik bosqichlarni soddalashtirishda, shu jumladan, qonunchilik texnikasi talablariga moslashtirishda elektron dastur imkoniyatlaridan foydalanishni yoʻlga qoʻyish.</div></div><div class="ACT_TEXT"><div name="-6854357" id="-6854357">Sakkizinchi asosiy yoʻnalish — qonunchilikni yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasiga </a>muvofiqlashtirish hamda “Oʻzbekiston — 2030” strategiyasini toʻliq amalga oshirish.</div></div><div class="ACT_TEXT"><div name="-6854359" id="-6854359">Ushbu yoʻnalishda quyidagilar amalga oshiriladi:</div></div><div class="ACT_TEXT"><div name="-6854360" id="-6854360">yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasidan </a>kelib chiqib, qonunosti hujjatlarini ularda qonun darajasida belgilanishi lozim boʻlgan normalar borligi yuzasidan toʻliq xatlovdan oʻtkazish hamda ularni qonun darajasida tartibga solish choralarini koʻrish;</div></div><div class="ACT_TEXT"><div name="-6854363" id="-6854363">yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasidan </a>kelib chiqib, qonunlarda belgilangan davlat organlari tomonidan insonga nisbatan qoʻllaniladigan huquqiy taʼsir choralarini mutanosiblik va qonunlarda nazarda tutilgan maqsadlarga erishish uchun yetarlilik prinsiplariga muvofiqligi yuzasidan xatlovdan oʻtkazish;</div></div><div class="ACT_TEXT"><div name="-6854371" id="-6854371">yangi tahrirdagi Oʻzbekiston Respublikasi <a href="https://lex.uz/docs/-6445145">Konstitutsiyasidan </a>kelib chiqib, xalqaro shartnomalarning milliy qonunchilikdagi oʻrnini belgilash;</div></div><div class="ACT_TEXT"><div name="-6854375" id="-6854375">milliy parlamentarizm va davlat vakillik hokimiyati tizimining huquqiy asoslarini kuchaytirish, shu jumladan, yangicha konstitutsiyaviy-huquqiy sharoitlardan kelib chiqib, parlament nazoratini amalga oshirish tartibini takomillashtirish, mazkur sohada deputatlar va senatorlarni zarur koʻnikmalarga oʻrgatishni uzluksiz takomillashtirib boruvchi tizimni yoʻlga qoʻyish, parlament faoliyatini tartibga soluvchi barcha qonun hujjatlarini tizimlashtirish, Senatning yangi konstitutsiyaviy vakolatlarini bajarishga oid faoliyatini qonunchilikda aks ettirish;</div></div><div class="ACT_TEXT"><div name="-6854378" id="-6854378">davlat hokimiyati va boshqaruvi organlari faoliyati samaradorligini taʼminlaydigan qonunchilikni rivojlantirish, xususan, hokim va mahalliy Kengash raisi faoliyatining bir-biridan ajratish yuzasidan qonunchilik hujjatlarini takomillashtirish, markaziy hokimiyat va mahalliy hokimiyat organlari oʻrtasida vakolatlarni aniq chegaralash, shahar, tuman va viloyat darajasida mahalliy davlat hokimiyati organlari vakolatlarini aniq taqsimlash, mahalliy Kengashlar va hokimliklar faoliyatiga oid 500 dan ortiq qonunchilik hujjatlarini tizimlashtirish, fuqarolarning oʻzini-oʻzi boshqarish tizimini yanada rivojlantirish, davlat organlarining ayrim vakolatlarini oʻzini oʻzi boshqarish organlariga davlat-xususiy sherikchilik va autsorsing modellari asosida oʻtkazish amaliyotini rivojlantirish, mahalliy davlat hokimiyati organlari faoliyatini raqamlashtirish, ularning ishida zamonaviy axborot texnologiyalaridan keng foydalanish uchun huquqiy asoslarni yaratish;</div></div><div class="ACT_TEXT"><div name="-6854380" id="-6854380">maʼmuriy qonunchilikni rivojlantirish, xususan, noqonuniy maʼmuriy aktni qabul qilgan mansabdor shaxslarning siyosiy javobgarligi institutini joriy qilish, maʼmuriy-nazorat faoliyatini faqatgina qonun hujjatlarida belgilangan ochiq, oshkora va hammaga tushunarli boʻlgan tartib-taomillar asosida amalga oshirishni qatʼiy belgilash, davlat organlari va boshqa tashkilotlarga ular faoliyatining ochiqligini taʼminlash, davlat fuqarolik xizmatchilariga ommaviy axborot vositalari bilan ochiq va oʻzaro hamkorlik qilish madaniyatini singdirish;</div></div><div class="ACT_TEXT"><div name="-6854383" id="-6854383">iqtisodiy munosabatlarni huquqiy tartibga solish, shu jumladan, Davlat budjeti mablagʻlari hisobidan yirik investitsiya loyihalarini amalga oshirish ustidan jamoatchilik nazoratini amalga oshirish asoslarini takomillashtirish, korporativ qonunchilikni rivojlantirish, sogʻlom raqobat muhitini shakllantirishga va monopoliyaga qarshi taʼsirchan nazorat mexanizmini joriy qilish, bozor munosabatlarini rivojlantirish va adolatli raqobat uchun shart-sharoitlar yaratish, iqtisodiy faoliyat, tadbirkorlik va mehnat qilish erkinligi kafolatlarini yanada mustahkamlash, yashirin iqtisodiyotni qisqartirish, ruxsat berish, litsenziyalash, davlat buyurtmalari boʻyicha ishlar (xizmatlar) koʻrsatishga oid qonun hujjatlarini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854385" id="-6854385">ijtimoiy munosabatlarni huquqiy tartibga solish, xususan, uy-joyli boʻlish huquqi, davlat uy-joy qurilishini ragʻbatlantirishiga oid konstitutsiyaviy normani qonunlarda aks ettirish, pensiya va sugʻurta tizimini takomillashtirish, koʻp kvartirali uylar va boshqa koʻchmas mulk obyektlarini ulush kiritish asosida qurishni tartibga soluvchi qonuniy asoslarni shakllantirish, gender tenglikni taʼminlash, ayollar va bolalarga nisbatan zoʻravonlikning barcha shakllariga qarshi kurashishning qonuniy mexanizmlarini takomillashtirish;</div></div><div class="ACT_TEXT"><div name="-6854387" id="-6854387">sud-huquq sohasida Oʻzbekiston Respublikasining qonunchiligini rivojlantirish, shu jumladan, inson bilan davlat organlarining oʻzaro munosabatlarida yuzaga keladigan qonunchilikdagi barcha ziddiyatlar va noaniqliklar inson foydasiga talqin etilishini, huquqiy taʼsir choralarini qoʻllashda mutanosiblik prinsipiga amal qilinishini taʼminlash, advokatning protsessual vakolatlarini kengaytirish, uning kasbiy faoliyatini amalga oshirish uchun zarur shart-sharoitlarni taʼminlash, mediatsiya, hakamlik va arbitraj muhokamalari institutlari uchun keng imkoniyatlarni yaratish, korrupsiyaga qarshi kurashish sohasida qonunchilikni yanada takomillashtirish, unda korrupsiya alomatlariga ega boʻlgan barcha xatti-harakatlarning oldini oluvchi va bartaraf etuvchi samarali va taʼsirchan mexanizmlarni joriy qilish, manfaatlar toʻqnashuviga sabab boʻlishi mumkin boʻlgan barcha omillarni davlat xizmati tizimidan bartaraf etish, “Xabeas korpus” institutini xorijiy mamlakatlarning amaliyoti asosida qoʻllash, Miranda qoidalari va inson huquqlari sohasidagi boshqa umumeʼtirof etilgan xalqaro standartlarni milliy qonunchilikka tatbiq etish, fuqarolik va iqtisodiy odil sudlov jarayoniga “elektron ish” tizimlarini joriy qilish, mazkur tizimlarni sud hal qiluv qarori ijrosini taʼminlovchi barcha davlat organlari tizimlari bilan integratsiya qilish;</div></div><div class="ACT_TEXT"><div name="-6854389" id="-6854389">atrof muhitni muhofaza qilish va tabiiy resurslardan oqilona foydalanishni tartibga soluvchi huquqiy asoslarni yanada rivojlantirish, shu jumladan, Orolboʻyi hududini strategik rivojlantirish va bu borada xalqaro hamkorlikning aniq va samarali mexanizmini belgilash, yaylovlar, shu jumladan ularni nazorat qilishga oid qonun hujjatlarini qayta koʻrib chiqib, takomillashtirish, chang boʻronlariga qarshi kurashishning qonuniy asoslarini takomillashtirish, hayvonot va oʻsimlik dunyosi obyektlaridan noqonuniy foydalanish ustidan nazoratni kuchaytirish, har bir qabul qilinayotgan qonunlarni va boshqa normativ-huquqiy hujjatlarni ekologiya va atrof-muhitga taʼsir oʻtkazishi nuqtai nazaridan baholovchi ekologik ekspertizadan majburiy oʻtkazish amaliyotini yoʻlga qoʻyish;</div></div><div class="ACT_TEXT"><div name="-6854391" id="-6854391">xalqaro huquq normalarini milliy qonunchilikka implementatsiya qilish mexanizmini ishlab chiqish, xususan, qonunchilikni va huquqni qoʻllash amaliyotini Jahon savdo tashkilotining qoida, meʼyor va bitimlariga moslashtirish, umumeʼtirof etilgan, Oʻzbekiston rasman tan olgan xalqaro huquq normalarini milliy amaliyotda qoʻllash mexanizmini joriy qilish, Oʻzbekiston Respublikasi xalqaro shartnomalari tizimini tartibga solish, ularni toʻla roʻyxatga olish va ularning ijrosi (milliy qonunchilikka joriy qilinishi) ustidan doimiy monitoring tizimini belgilash, xalqaro xususiy huquqda tadbirkorlik va investitsiyalar sohasida milliy va xorijiy qonunchilik “toʻqnashuvi”ning oldini olish, kolliziya va toʻgʻridan-toʻgʻri tartibga solish uslublarini qonuniylashtirish, pandemiya va boshqa favqulodda vaziyatlarda ijtimoiy munosabatlarni tartibga solishning oʻziga xos jihatlarini mustahkamlash.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854395" id="-6854395">VI. Qonun ijodkorligi faoliyati boʻyicha dasturni roʻyobga chiqarish mexanizmi, uning ustidan monitoring olib borish va moliyalashtirish</div></div><div class="ACT_TEXT"><div name="-6854397" id="-6854397">Qonun ijodkorligi faoliyati boʻyicha dasturni amalga oshirishda davlat hokimiyati va boshqaruvi organlari, huquqni muhofaza qiluvchi organlar, shuningdek, fuqarolik jamiyati institutlari va OAV ishtirok etadilar.</div></div><div class="ACT_TEXT"><div name="-6854398" id="-6854398">Dasturning sifatli va samarali bajarilishini nazorat qilishning quyidagi tizimi yoʻlga qoʻyiladi:</div></div><div class="ACT_TEXT"><div name="-6854400" id="-6854400">birinchidan, Oliy Majlis palatalari Qonun ijodkorligi faoliyati boʻyicha dasturda belgilangan vazifalarning amalga oshirilishi yuzasidan:</div></div><div class="ACT_TEXT"><div name="-6854403" id="-6854403">muntazam monitoring olib borib, belgilangan chora-tadbirlar sifatli va oʻz vaqtida ijro etilishi boʻyicha taklif va tavsiyalarni tegishli vazirlik va idoralarga kiritib boradi;</div></div><div class="ACT_TEXT"><div name="-6854406" id="-6854406">doimiy ravishda aniq koʻrsatkichlar va erishilgan natijalar aks ettirilgan batafsil axborotni oʻz veb-saytida joylashtirib boradi;</div></div><div class="ACT_TEXT"><div name="-6854408" id="-6854408">ikkinchidan, Qonun ijodkorligi faoliyati boʻyicha dasturda belgilangan masʼullar oʻzlariga yuklatilgan vazifalar ijrosiga doir maʼlumotlarni har chorakda Oliy Majlis Qonunchilik palatasiga taqdim etadi;</div></div><div class="ACT_TEXT"><div name="-6854416" id="-6854416">uchinchidan, Oliy Majlis Qonunchilik palatasi vazirlik va idoralar rahbarlarining Qonun ijodkorligi faoliyati boʻyicha dastur ijrosi yuzasidan axborotini har olti oyda eshitib, tanqidiy muhokama qilib boradi;</div></div><div class="ACT_TEXT"><div name="-6854419" id="-6854419">toʻrtinchidan, qonun loyihalari boʻyicha turli ekspertizalarni oʻtkazish amaliyotini shakllantirish va faollashtirish maqsadida qonun ijodkorligi bilan shugʻullanadigan subyektlar tomonidan tayyorlanayotgan qonun loyihalari boʻyicha ekspertizalarni oʻtkazish uslubiyoti ustidan Oliy Majlis Qonunchilik palatasi huzuridagi Parlament tadqiqotlari instituti tomonidan monitoring oʻtkazish amaliyoti joriy qilinadi.</div></div><div class="ACT_TEXT"><div name="-6854422" id="-6854422">Qonun ijodkorligi faoliyati boʻyicha dasturning toʻliq va tizimli amalga oshirilishi seminarlar, konferensiyalar va boshqa tadbirlar doirasida ommaviy axborot vositalarida keng yoritib boriladi.</div></div><div class="ACT_TEXT"><div name="-6854426" id="-6854426">Shuningdek, qonun ijodkorligini takomillashtirish borasida Oʻzbekiston Respublikasida qabul qilinayotgan chora-tadbirlar hamda ularning natijalari toʻgʻrisida jamoatchilik hamda xalqaro hamjamiyat tizimli ravishda xabardor qilib boriladi.</div></div><div class="ACT_TEXT"><div name="-6854429" id="-6854429">Qonun ijodkorligi faoliyati boʻyicha dasturning chora-tadbirlari Oʻzbekiston Respublikasining Davlat budjeti mablagʻlari, qonunchilik tashabbusi huquqi subyektlarining budjetdan tashqari mablagʻlari hamda qonunchilikda taqiqlanmagan boshqa manbalar hisobidan moliyalashtiriladi.</div></div><div class="ACT_TEXT"><div name="-6854433" id="-6854433">Qonun ijodkorligi faoliyati boʻyicha dasturni amalga oshirishga hamkorlik doirasida xalqaro tashkilotlar va moliya institutlarining mablagʻlari, grantlari hamda qonun hujjatlarida taqiqlanmagan boshqa mablagʻlar ham jalb qilinishi mumkin.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6854435" id="-6854435">VII. Qonun ijodkorligi faoliyati boʻyicha dasturni amalga oshirishdan kutilayotgan natijalar</div></div><div class="ACT_TEXT"><div name="-6854442" id="-6854442">Qonun ijodkorligi faoliyati boʻyicha dastur doirasida belgilangan vazifalarni amalga oshirish orqali quyidagi natijalarga erishish nazarda tutiladi:</div></div><div class="ACT_TEXT"><div name="-6854445" id="-6854445">qonun ijodkorligi sohasida rivojlangan mamlakatlarning qonunchilik texnikasi va huquqni qoʻllash amaliyotining eng ijobiy tajribalarini implementatsiya qilishning samaradorligi oshadi;</div></div><div class="ACT_TEXT"><div name="-6854447" id="-6854447">qonun ijodkorligi sohasida mavjud kamchiliklar bartaraf etiladi, qonunning normativ-huquqiy hujjatlar tizimidagi mavqeyi yanada oshadi;</div></div><div class="ACT_TEXT"><div name="-6854450" id="-6854450">qonunlarni samarali va taʼsirchan tartibga solishni taʼminlashga qaratilgan tashkiliy-huquqiy va boshqa kompleks chora-tadbirlar tizimi yaratiladi, qonunlar ijrosini oʻrganish orqali hukumat va ijro etuvchi boshqa organlar faoliyatining samaradorligini baholash tizimi joriy qilinadi;</div></div><div class="ACT_TEXT"><div name="-6854453" id="-6854453">tartibga solish yukini kamaytirish, ortiqcha byurokratik toʻsiqlarni kamaytirish hisobiga huquqni qoʻllash amaliyoti soddalashtiriladi, barcha uchun qulay boʻlgan sodda va ixcham qonunchilik tizimi yaratiladi;</div></div><div class="ACT_TEXT"><div name="-6854455" id="-6854455">toʻgʻridan-toʻgʻri amal qiladigan qonunlarni qabul qilish amaliyotini kengaytirish evaziga mamlakatda qonun ustuvorligi prinsipi roʻyobga chiqadi, natijada mamlakatning qonun ustuvorligi boʻyicha xalqaro reytingidagi oʻrni yaxshilanadi.</div></div><div class="BY_DEFAULT"><div name="-6854459" id="-6854459"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-6854464" id="-6854464">Oʻzbekiston Respublikasi Oliy Majlisi Qonunchilik palatasi Kengashining va Oʻzbekiston Respublikasi Oliy Majlisi Senati Kengashining 2024-yil 15-fevraldagi № 4036-IV/KQ-683-IV-son Qoʻshma <a href="https://lex.uz/docs/-6853994">qaroriga</a><br />
2-ILOVA</div></div><div class="ACT_TITLE_APPL"><div name="-6854469" id="-6854469"><strong>Qonun ijodkorligi faoliyati boʻyicha dasturni 2024-yilda amalga oshirish yuzasidan</strong></div></div><div class="ACT_FORM"><div name="-6854471" id="-6854471"><strong>ChORA-TADBIRLAR REJASI</strong></div></div><div class="BY_DEFAULT"><div name="-6854473" id="-6854473"></div></div><div class="TABLE_STD2"><div name="-6854500" id="-6854500"><table class="Table" style="width:100.0%;border-collapse:collapse;border:none" width="100%">
